using System;
using System.Collections.Generic;
using System.Linq;
using System.Reflection;
using System.Threading.Tasks;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Controls.Primitives;
using System.Windows.Media;
using System.Windows.Threading;
using Esri.ArcGISRuntime.Mapping;
using Esri.ArcGISRuntime.UI.Controls;

namespace NG.GIS.CAD.Exporter.Views;

public partial class ExporterWindow
{
    private bool _nggisMaterialViewLayerFlowInstalled;
    private bool _nggisNgOdsWarmupStarted;
    private DispatcherTimer? _nggisMaterialViewLayerRetryTimer;
    private int _nggisMaterialViewLayerRetryCount;
    private const string NggisMaterialViewMapServerUrl = "https://gis.nationalgrid.com/arcgis/rest/services/MA/Material_View_MA/MapServer";
    private const string NggisPortalWebMapItemId = "c214d72caefb40699b129bc47b1b22a7";
    private const string NggisPortalRootUrl = "https://gis.nationalgrid.com/portal";

    private void InstallNggisMaterialViewLayerFlow()
    {
        if (_nggisMaterialViewLayerFlowInstalled) return;
        _nggisMaterialViewLayerFlowInstalled = true;
        Loaded += async (_, __) =>
        {
            await WarmNgOdsFirstAsync();
            ScheduleMaterialViewLayerRetries("window loaded");
        };
        AddHandler(ButtonBase.ClickEvent, new RoutedEventHandler((_, __) => ScheduleMaterialViewLayerRetries("button action")), true);
        _ = Dispatcher.BeginInvoke(async () =>
        {
            await WarmNgOdsFirstAsync();
            ScheduleMaterialViewLayerRetries("startup");
        }, DispatcherPriority.Loaded);
    }

    private async Task WarmNgOdsFirstAsync()
    {
        if (_nggisNgOdsWarmupStarted) return;
        _nggisNgOdsWarmupStarted = true;
        await Task.Yield();
        try
        {
            var invoked = false;
            var flags = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic;
            var values = GetType().GetFields(flags).Select(f => SafeGet(() => f.GetValue(this)))
                .Concat(GetType().GetProperties(flags).Select(p => SafeGet(() => p.GetValue(this))));
            foreach (var value in values)
            {
                if (value == null) continue;
                var typeName = value.GetType().Name;
                if (!typeName.Contains("NgOds", StringComparison.OrdinalIgnoreCase) && !typeName.Contains("WorkOrderLookup", StringComparison.OrdinalIgnoreCase)) continue;
                invoked = await TryInvokeWarmupMethodAsync(value) || invoked;
            }
            AppendNggisLayerStatus(invoked ? "NG_ODS startup preload invoked before user interaction." : "NG_ODS startup preload did not find a warm-up method; NG_ODS will initialize on first lookup.");
        }
        catch (Exception ex)
        {
            AppendNggisLayerStatus("NG_ODS startup preload failed: " + ex.GetType().Name + ": " + ex.Message);
        }
    }

    private static object? SafeGet(Func<object?> getter)
    {
        try { return getter(); } catch { return null; }
    }

    private static async Task<bool> TryInvokeWarmupMethodAsync(object target)
    {
        var names = new[] { "Warm", "Preload", "Load", "Initialize", "Ensure", "Refresh", "Cache" };
        foreach (var method in target.GetType().GetMethods(BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic).Where(m => m.GetParameters().Length == 0 && names.Any(n => m.Name.Contains(n, StringComparison.OrdinalIgnoreCase))))
        {
            try
            {
                var result = method.Invoke(target, null);
                if (result is Task task) await task;
                return true;
            }
            catch { }
        }
        return false;
    }

    private void ScheduleMaterialViewLayerRetries(string reason)
    {
        _nggisMaterialViewLayerRetryCount = 0;
        if (_nggisMaterialViewLayerRetryTimer == null)
        {
            _nggisMaterialViewLayerRetryTimer = new DispatcherTimer(DispatcherPriority.Background, Dispatcher) { Interval = TimeSpan.FromMilliseconds(650) };
            _nggisMaterialViewLayerRetryTimer.Tick += async (_, __) =>
            {
                _nggisMaterialViewLayerRetryCount++;
                await EnsureMaterialViewLayerOnEveryMapViewAsync("retry " + _nggisMaterialViewLayerRetryCount);
                if (_nggisMaterialViewLayerRetryCount >= 20) _nggisMaterialViewLayerRetryTimer.Stop();
            };
        }
        _nggisMaterialViewLayerRetryTimer.Stop();
        _nggisMaterialViewLayerRetryTimer.Start();
        _ = Dispatcher.BeginInvoke(async () => await EnsureMaterialViewLayerOnEveryMapViewAsync(reason), DispatcherPriority.Loaded);
    }

    private async Task EnsureMaterialViewLayerOnEveryMapViewAsync(string reason)
    {
        try
        {
            var mapViews = FindNggisChildren<MapView>(this).Distinct().ToList();
            if (mapViews.Count == 0)
            {
                AppendNggisLayerStatus("Material_View_MA not added yet: no MapView found (" + reason + ").");
                return;
            }
            var token = await TryGetArcGisTokenAsync();
            var layerUrl = AppendTokenIfPresent(NggisMaterialViewMapServerUrl, token);
            foreach (var mapView in mapViews)
            {
                if (mapView.Map == null)
                {
                    mapView.Map = new Map(BasemapStyle.ArcGISTopographic);
                }
                var existing = mapView.Map.OperationalLayers.FirstOrDefault(l => string.Equals(l.Name, "Material_View_MA", StringComparison.OrdinalIgnoreCase));
                if (existing != null)
                {
                    existing.IsVisible = true;
                    continue;
                }
                var material = new ArcGISMapImageLayer(new Uri(layerUrl)) { Name = "Material_View_MA", IsVisible = true };
                mapView.Map.OperationalLayers.Insert(0, material);
                await material.LoadAsync();
                if (material.LoadStatus == Esri.ArcGISRuntime.LoadStatus.Loaded)
                {
                    foreach (var sub in material.Sublayers) sub.IsVisible = true;
                    AppendNggisLayerStatus("Material_View_MA REST MapServer layer added (" + reason + "). Sublayers: " + material.Sublayers.Count + "; map operational layers: " + mapView.Map.OperationalLayers.Count + "; portal item reference: " + NggisPortalWebMapItemId + ".");
                }
                else if (material.LoadError != null)
                {
                    AppendNggisLayerStatus("Material_View_MA load error: " + material.LoadError.GetType().Name + ": " + material.LoadError.Message);
                }
            }
        }
        catch (Exception ex)
        {
            AppendNggisLayerStatus("Material_View_MA add failed: " + ex.GetType().Name + ": " + ex.Message);
        }
    }

    private async Task<string?> TryGetArcGisTokenAsync()
    {
        await Task.Yield();
        var flags = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic;
        var values = GetType().GetFields(flags).Select(f => SafeGet(() => f.GetValue(this)))
            .Concat(GetType().GetProperties(flags).Select(p => SafeGet(() => p.GetValue(this))));
        foreach (var value in values)
        {
            var token = TryExtractToken(value);
            if (!string.IsNullOrWhiteSpace(token)) return token;
        }
        return null;
    }

    private static string? TryExtractToken(object? value)
    {
        if (value == null) return null;
        if (value is string s && LooksLikeToken(s)) return s;
        var flags = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic;
        foreach (var prop in value.GetType().GetProperties(flags))
        {
            if (!prop.Name.Contains("Token", StringComparison.OrdinalIgnoreCase)) continue;
            var propValue = SafeGet(() => prop.GetValue(value));
            if (propValue is string token && LooksLikeToken(token)) return token;
        }
        foreach (var field in value.GetType().GetFields(flags))
        {
            if (!field.Name.Contains("Token", StringComparison.OrdinalIgnoreCase)) continue;
            var fieldValue = SafeGet(() => field.GetValue(value));
            if (fieldValue is string token && LooksLikeToken(token)) return token;
        }
        return null;
    }

    private static bool LooksLikeToken(string token)
    {
        return token.Length > 20 && !token.Contains(" ") && !token.StartsWith("http", StringComparison.OrdinalIgnoreCase);
    }

    private static string AppendTokenIfPresent(string url, string? token)
    {
        if (string.IsNullOrWhiteSpace(token)) return url;
        var sep = url.Contains("?") ? "&" : "?";
        return url + sep + "token=" + Uri.EscapeDataString(token);
    }

    private static IEnumerable<T> FindNggisChildren<T>(DependencyObject parent) where T : DependencyObject
    {
        if (parent == null) yield break;
        var count = VisualTreeHelper.GetChildrenCount(parent);
        for (var i = 0; i < count; i++)
        {
            var child = VisualTreeHelper.GetChild(parent, i);
            if (child is T typed) yield return typed;
            foreach (var nested in FindNggisChildren<T>(child)) yield return nested;
        }
    }

    private void AppendNggisLayerStatus(string message)
    {
        try
        {
            var textBox = FindName("WorkOrderGeometryTextBox") as TextBox;
            if (textBox != null && !textBox.Text.Contains(message))
            {
                textBox.Text = string.IsNullOrWhiteSpace(textBox.Text) ? message : textBox.Text + Environment.NewLine + message;
            }
        }
        catch { }
    }
}