using System;
using System.Reflection;
using System.Windows;
namespace NG.GIS.CAD.Exporter.Views;
public partial class ExporterWindow
{
    private void StartManualProposedMainSegment_Click(object sender, RoutedEventArgs e)
    {
        InvokeFirstManualHandler(sender, e, nameof(StartManualProposedMainSegment_Click), "StartManualProposedPipelineSegment_Click", "StartManualProposedPipelineMultiSegment_Click", "StartManualProposedMainSegments_Click", "StartManualProposedPipeline_Click");
    }
    private void ApplyManualProposedMainSegment_Click(object sender, RoutedEventArgs e)
    {
        InvokeFirstManualHandler(sender, e, nameof(ApplyManualProposedMainSegment_Click), "ApplyManualProposedPipelineSegment_Click", "ApplyManualProposedPipelineMultiSegment_Click", "ApplyManualProposedMainSegments_Click", "ApplyManualProposedPipeline_Click");
    }
    private void FinishManualProposedMainSegments_Click(object sender, RoutedEventArgs e)
    {
        InvokeFirstManualHandler(sender, e, nameof(FinishManualProposedMainSegments_Click), "FinishManualProposedPipelineSegments_Click", "FinishManualProposedPipelineMultiSegment_Click", "FinishManualProposedPipeline_Click", "FinishManualProposedMainSegment_Click");
    }
    private void ClearManualProposedMainSegments_Click(object sender, RoutedEventArgs e)
    {
        InvokeFirstManualHandler(sender, e, nameof(ClearManualProposedMainSegments_Click), "ClearManualProposedPipelineSegments_Click", "ClearManualProposedPipelineMultiSegment_Click", "ClearManualProposedPipeline_Click", "ClearManualProposedMainSegment_Click");
    }
    private void InvokeFirstManualHandler(object sender, RoutedEventArgs e, string currentName, params string[] candidateNames)
    {
        foreach (var candidateName in candidateNames)
        {
            var method = GetType().GetMethod(candidateName, BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
            if (method == null || method.Name == currentName)
            {
                continue;
            }
            var parameters = method.GetParameters();
            if (parameters.Length == 2)
            {
                method.Invoke(this, new object[] { sender, e });
                return;
            }
            if (parameters.Length == 0)
            {
                method.Invoke(this, null);
                return;
            }
        }
        MessageBox.Show("Manual proposed main multi-segment command is wired in XAML, but no underlying implementation method was found.", "NG GIS CAD Exporter", MessageBoxButton.OK, MessageBoxImage.Warning);
    }
}
