<Window x:Class="NG.GIS.CAD.Exporter.Views.NgOdsConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NG_ODS database connection" Height="360" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="#555555" Margin="0,0,0,12"
                   Text="The NG_ODS work order lookup needs a database connection. Enter the details below; they are tested before being saved."/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Server" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="ServerTextBox" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Database" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="DatabaseTextBox" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="User ID" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="UserIdTextBox" Margin="0,0,0,8"/>

        <TextBlock    Grid.Row="4" Grid.Column="0" Text="Password" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <PasswordBox  Grid.Row="4" Grid.Column="1" x:Name="PasswordBoxInput" Margin="0,0,0,8"/>

        <CheckBox Grid.Row="5" Grid.Column="1" x:Name="RememberCheckBox" IsChecked="True" Margin="0,4,0,8"
                  Content="Remember for this Windows user"/>

        <TextBlock Grid.Row="6" Grid.ColumnSpan="2" x:Name="StatusTextBlock" TextWrapping="Wrap"
                   Foreground="#B00020" VerticalAlignment="Top" Margin="0,4,0,8"/>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="TestButton" Content="Test" Click="Test_Click" Width="90" Padding="8,4" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="Test and save" Click="Save_Click" Width="130" Padding="8,4" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="Cancel" Click="Cancel_Click" Width="90" Padding="8,4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
