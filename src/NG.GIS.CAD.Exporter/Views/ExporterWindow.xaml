<Window x:Class="NG.GIS.CAD.Exporter.Views.ExporterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="National Grid GIS CAD Exporter" Height="760" Width="1180"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- Placeholder text shown inside an empty field. Sits over the TextBox rather than
             retemplating it, so the box keeps its normal focus and hover chrome. Hit testing is off
             so clicks land on the field underneath. -->
        <!-- The furniture shared by the data sources panel and the map layers tree. Both are lists of
             layers in draw order that are dragged into place and taken off, so they are given the same
             grip, the same Remove button and the same second line rather than each growing its own.
             Held here so the two cannot drift apart the next time one of them is touched. -->
        <Style x:Key="ListRowGrip" TargetType="TextBlock">
            <Setter Property="Text" Value="&#x2807;&#x2807;"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="SizeAll"/>
            <Setter Property="ToolTip" Value="Drag this onto another entry to change the draw order. The top of the list draws on top."/>
        </Style>
        <Style x:Key="ListRowRemoveButton" TargetType="Button">
            <Setter Property="Content" Value="Remove"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <!-- Collapses when it has nothing to say, so an entry with no URL and no status is a single
             line rather than one line of text over two of blank. -->
        <Style x:Key="ListRowSubText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- The triangle on a map layer group. Drawn here because the retemplated TreeViewItem below
             cannot borrow the stock one, which belongs to the template it replaces. -->
        <Style x:Key="MapLayerTreeExpanderToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="16" Height="16">
                            <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 0 8 Z" Fill="#666666"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Data" Value="M 0 0 L 8 0 L 4 5 Z"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldPlaceholder" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9A9A"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="Bold" Width="280"/>
            <TextBox Text="{Binding ProfilePath, UpdateSourceTrigger=PropertyChanged}" MinWidth="560" Margin="0,0,8,0"/>
            <Button Content="Load Profile" Command="{Binding LoadProfileCommand}" Margin="0,0,8,0" Padding="12,4"/>
            <!-- Capped and pulled left because this is the DockPanel's last child, which fills whatever
                 width is left over. On a wide window that made Save Settings a button several hundred
                 pixels across sitting next to a normal sized Load Profile. Without the left alignment a
                 capped stretch centres itself instead, leaving the pair separated by a gap. -->
            <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Padding="12,4"
                    MaxWidth="140" HorizontalAlignment="Left"/>
        </DockPanel>
        <Grid Grid.Row="1">
                                                                                    <Grid x:Name="MethodPage">
                <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                    <TextBlock Text="Export method" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                    <RadioButton x:Name="WorkOrderDrivenExportRadio" Content="Work Order driven export" IsChecked="True" Checked="ExportDisplayMode_Checked" Margin="0,0,0,8"/>
                    <RadioButton x:Name="ManualProposedPipelineRadio" Content="Manual proposed pipeline segments" Checked="ExportDisplayMode_Checked" Margin="0,0,0,8"/>
                    <RadioButton x:Name="VisibleMapExportRadio" Content="Visible map viewport export" Checked="ExportDisplayMode_Checked" Margin="0,0,0,18"/>
                    <TextBlock Text="Work order lookup from NG_ODS" FontSize="16" FontWeight="Bold" Margin="0,12,0,8"/>
                    <TextBlock Text="Work Order Number"/>
                    <ComboBox x:Name="WorkOrderSelectionComboBox" PreviewKeyDown="NgOdsWorkOrderCombo_PreviewKeyDown" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" DisplayMemberPath="WorkOrderNumberDisplay" Loaded="NgOdsWorkOrderCombos_Loaded" DropDownOpened="NgOdsWorkOrderNumberCombo_DropDownOpened" KeyUp="NgOdsWorkOrderNumberCombo_KeyUp" SelectionChanged="NgOdsWorkOrderNumberCombo_SelectionChanged" LostFocus="NgOdsWorkOrderCombo_LostFocus" Margin="0,0,0,8"/>
                    <TextBlock Text="Work Order Name"/>
                    <ComboBox x:Name="WorkOrderNameComboBox" PreviewKeyDown="NgOdsWorkOrderCombo_PreviewKeyDown" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" DisplayMemberPath="WorkOrderNameDisplay" Loaded="NgOdsWorkOrderCombos_Loaded" DropDownOpened="NgOdsWorkOrderNameCombo_DropDownOpened" KeyUp="NgOdsWorkOrderNameCombo_KeyUp" SelectionChanged="NgOdsWorkOrderNameCombo_SelectionChanged" LostFocus="NgOdsWorkOrderCombo_LostFocus" Margin="0,0,0,8"/>
                    <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,12" Background="#FAFAFA">
                        <TextBlock x:Name="ProposedMainAvailabilityText" TextWrapping="Wrap" Foreground="#555555"
                                   Text="Choose a work order and its proposed main will be looked up in GIS."/>
                    </Border>
                    <TextBlock Text="Padding ft (applies to Work Order driven export and Manual proposed pipeline segments)"/>
                    <TextBox x:Name="WorkOrderPaddingTextBox" Text="{Binding PaddingFeet, UpdateSourceTrigger=PropertyChanged}" TextChanged="PaddingInput_TextChanged" Margin="0,0,0,12"/>
                    <TextBlock Text="The full NG_ODS work order query loads once when this page opens, then both dropdowns filter locally. Selecting either Work Order Number or Work Order Name updates the other dropdown from the same NG_ODS row." TextWrapping="Wrap" Foreground="#555555"/>
                    <TextBlock Text="CAD template (.dwt)" FontSize="16" FontWeight="Bold" Margin="0,18,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="Pick .dwt" Click="PickLocalDwtTemplate_Click" Width="80" Height="24" Margin="0,0,5,0"/>
                        <TextBox x:Name="LocalDwtPathTextBox" Width="440" Height="24" IsReadOnly="True" Margin="0,0,5,0"
                                 Text="{Binding TemplatePath, Mode=OneWay}"/>
                        <Button Content="Open" Click="OpenLocalDwtTemplate_Click" Width="70" Height="24"/>
                    </StackPanel>
                    <TextBlock x:Name="LocalDwtStatusText" Text="Select a local or synced .dwt, or sign in below to browse SharePoint." TextWrapping="Wrap" Foreground="#555555"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Pick from SharePoint" Click="PickSharePointTemplate_Click" Padding="8,2" Margin="0,0,6,0"/>
                        <TextBlock x:Name="SharePointStatusText" Text="" VerticalAlignment="Center" Foreground="#555555" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
                        <Grid x:Name="ExtentPage" Visibility="Collapsed" IsVisibleChanged="ExtentPage_IsVisibleChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" x:Name="LeftPaneSections" SizeChanged="LeftPaneSections_SizeChanged">
                    <!-- The mode buttons live in row 0, which nothing resizes or collapses, so they
                         are always reachable however the sections below are arranged.

                         Each of the four sections then owns a row, with a drag bar between each pair.
                         A section is starred while open, so an open section takes the free space and
                         several open sections share it, and Auto while closed, so a closed one is its
                         header and nothing more. The switch is made in code rather than by a style
                         trigger, because a style setter cannot be relied on for a row height once
                         anything has written one directly.

                         Splitters were taken out once for exactly that reason: a height a splitter
                         writes outranks anything a collapse would set, so a section that had been
                         dragged could no longer close. They are back because the heights are wanted,
                         and the collision is settled rather than avoided. The code that opens and
                         closes a section writes the row height itself, so a collapse always wins over
                         a drag; a dragged height is remembered and given back when the section is
                         opened again. Each bar is hidden unless both of the sections it sits between
                         are open, because dragging against a closed section can only produce a gap. -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="ModeReadoutRow" Height="*" MinHeight="60"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="MapLayersRow" Height="*" MinHeight="80"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="DataSourcesRow" Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="StripMapRow" Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: mode headers. Fixed. -->
                    <Grid Grid.Row="0">
                        <StackPanel x:Name="WorkOrderModeHeader">
                            <TextBlock Text="Work Order driven export" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <Button Content="Refresh Work Order Geometry + Buffer" Click="RefreshWorkOrderGeometry_Click" Padding="8" Margin="0,0,0,10"/>
                            <UniformGrid Columns="3" Margin="0,0,0,10">
                                <Button Content="Edit Imported Main" Click="EditImportedProposedMain_Click" Padding="8" Margin="0,0,4,0"/>
                                <Button Content="Apply Segment" Click="ApplyManualProposedMainSegment_Click" Padding="8" Margin="4,0,4,0"/>
                                <Button Content="Cancel Edit" Click="CancelImportedProposedMainEdit_Click" Padding="8" Margin="4,0,0,0"/>
                            </UniformGrid>
                            <TextBlock Text="Manual proposed pipeline segments" FontWeight="Bold" Margin="0,8,0,6"/>
                            <UniformGrid Columns="4" Margin="0,0,0,10">
                                <Button Content="Start Segment" Click="StartManualProposedMainSegment_Click" Padding="8" Margin="0,0,4,0"/>
                                <Button Content="Apply Segment" Click="ApplyManualProposedMainSegment_Click" Padding="8" Margin="4,0,4,0"/>
                                <Button Content="Finish Segments" Click="FinishManualProposedMainSegments_Click" Padding="8" Margin="4,0,4,0"/>
                                <Button Content="Clear Segments" Click="ClearManualProposedMainSegments_Click" Padding="8" Margin="4,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                        <StackPanel x:Name="ManualProposedPipelineModeHeader" Visibility="Collapsed">
                            <TextBlock Text="Manual proposed pipeline segments" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Padding from Page 1 is applied as a buffer around all manual proposed pipeline segments." TextWrapping="Wrap" Foreground="#555555" Margin="0,0,0,8"/>
                            <UniformGrid Columns="4" Margin="0,0,0,10">
                                <Button Content="Start Segment" Click="StartManualProposedMainSegment_Click" Padding="8" Margin="0,0,4,0"/>
                                <Button Content="Apply Segment" Click="ApplyManualProposedMainSegment_Click" Padding="8" Margin="4,0,4,0"/>
                                <Button Content="Finish Segments" Click="FinishManualProposedMainSegments_Click" Padding="8" Margin="4,0,4,0"/>
                                <Button Content="Edit Segment" Click="EditManualProposedMainSegment_Click" Padding="8" Margin="4,0,0,0"
                                        ToolTip="Pick a drawn segment by clicking it on the map, then drag its points and use Apply Segment, or press Delete to remove it."/>
                            </UniformGrid>
                        </StackPanel>
                        <StackPanel x:Name="VisibleMapModeHeader" Visibility="Collapsed">
                            <TextBlock Text="Visible map viewport export" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <Button Content="Commit Visible Map Extent" Click="SetExtentFromVisibleMap_Click" Padding="8" Margin="0,0,0,16"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: the mode readout, in a section of its own. The header names whichever
                         readout the method on page 1 is showing, since the three are the same box
                         used three ways and a fixed caption would be wrong for two of them. -->
                    <Expander Grid.Row="1" x:Name="ModeReadoutExpander" IsExpanded="True" Margin="0,2,0,0"
                              VerticalContentAlignment="Stretch"
                              Expanded="LeftPaneSection_ExpansionChanged" Collapsed="LeftPaneSection_ExpansionChanged">
                        <Expander.Style>
                            <Style TargetType="Expander">
                                <Setter Property="Header" Value="Work order geometry / buffer proof"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDrawPipelineRouteMethod}" Value="True">
                                        <Setter Property="Header" Value="Manual proposed pipeline segments"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCurrentDrawingViewMethod}" Value="True">
                                        <Setter Property="Header" Value="Live map extent (updates after pan/zoom)"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                    <Grid>
                        <Grid x:Name="WorkOrderModePanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0" x:Name="WorkOrderGeometryTextBox" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Text="This view is controlled by the first page. Change WO number, padding, or method on page 1."
                                       TextWrapping="Wrap" Foreground="#555555"/>
                        </Grid>
                        <Grid x:Name="ManualProposedPipelineModePanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="60"/>
                            </Grid.RowDefinitions>

                            <!-- Snapping was fixed at a foot with nothing on screen to say so. Both the
                                 distance and whether it happens at all are settings now, because a foot
                                 suits a street and not a plant yard. -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,6">
                                <CheckBox IsChecked="{Binding SnapProposedMainSegmentEnds}"
                                          Content="Snap segment ends together" FontWeight="SemiBold"
                                          ToolTip="Pulls the ends of separate segments onto the same point when they are drawn close enough, so a corridor drawn in pieces joins up."/>
                                <StackPanel Orientation="Horizontal" Margin="20,4,0,4"
                                            IsEnabled="{Binding SnapProposedMainSegmentEnds}">
                                    <TextBlock Text="Within" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Width="60" Text="{Binding ProposedMainSnapToleranceFeet, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="How far apart two ends may be and still be treated as the same point."/>
                                    <TextBlock Text="ft" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SnapSummary}" Foreground="#555555" TextWrapping="Wrap" Margin="0,0,0,2"/>
                            </StackPanel>

                            <TextBox Grid.Row="1" x:Name="ProposedPipelineTextBox" IsReadOnly="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" FontFamily="Consolas"/>

                        </Grid>
                        <Grid x:Name="VisibleMapModePanel" Visibility="Collapsed">
                            <TextBox x:Name="CapturedExtentTextBox" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                        </Grid>
                    </Grid>
                    </Expander>

                    <GridSplitter Grid.Row="2" x:Name="ModeReadoutSplitter" Height="5" HorizontalAlignment="Stretch"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                  Background="#E4E4E4" ShowsPreview="True" Cursor="SizeNS" Margin="0,2,0,0"
                                  ToolTip="Drag to give more room to the section above or below."/>

                    <!-- Row 3: map layers, in a section of its own on the same terms. -->
                    <Expander Grid.Row="3" x:Name="MapLayersExpander" Header="Map layers" IsExpanded="True" Margin="0,2,0,0"
                              VerticalContentAlignment="Stretch"
                              Expanded="LeftPaneSection_ExpansionChanged" Collapsed="LeftPaneSection_ExpansionChanged">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,4,6">
                                <Button Content="Expand all" Click="ExpandAllMapLayers_Click" Padding="8,2" Margin="0,0,6,0"/>
                                <Button Content="Collapse all" Click="CollapseAllMapLayers_Click" Padding="8,2" Margin="0,0,10,0"/>
                                <CheckBox Content="Legend" IsChecked="{Binding ShowMapLegend}" VerticalAlignment="Center"
                                          ToolTip="Show each layer's symbols. A layer drawn by category takes a row per class, so turning this off gives back the compact list."/>
                            </StackPanel>
                            <!-- Horizontal scrolling off, which is what lets the Remove buttons line up
                                 on the right. A scroller that can scroll sideways offers its items
                                 unlimited width, so a row asked to stretch has nothing to stretch to
                                 and sizes to its content instead; every button would sit at the end of
                                 its own layer name, at a different place on every row. Off, the rows
                                 get the pane's real width and long names are trimmed rather than
                                 scrolled to, with the full name on the tooltip. -->
                            <TreeView ItemsSource="{Binding MapLayers}" BorderThickness="0" Background="Transparent"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <!-- Retemplated for one reason: the stock TreeViewItem puts its
                                             header in a column sized to the header's own content, so
                                             asking the header to stretch changes nothing and a right
                                             aligned button inside it still lands at the end of the layer
                                             name. Here the header column is a star, so it takes the
                                             width of the pane and the buttons line up down the edge of
                                             it. The rest of the template is the stock arrangement:
                                             expander at the left, header beside it, children indented
                                             underneath. -->
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TreeViewItem">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition MinWidth="16" Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <ToggleButton x:Name="Expander" Grid.Row="0" Grid.Column="0"
                                                                      ClickMode="Press" VerticalAlignment="Top" Margin="0,3,0,0"
                                                                      Style="{StaticResource MapLayerTreeExpanderToggle}"
                                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                        <ContentPresenter x:Name="PART_Header" Grid.Row="0" Grid.Column="1"
                                                                          ContentSource="Header" HorizontalAlignment="Stretch"/>
                                                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsExpanded" Value="False">
                                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                        <Trigger Property="HasItems" Value="False">
                                                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Margin="0,2,0,2">
                                            <!-- A layer with one symbol keeps its swatch on the same
                                                 line as its checkbox, so the common case stays a one
                                                 line entry.

                                                 The row is a Border so that a top level layer can be
                                                 dragged onto another to change the draw order, the same
                                                 way the data source tiles are. The border itself is
                                                 invisible until a drop would land on this row. -->
                                            <Border BorderThickness="1" BorderBrush="Transparent" Padding="1,0,1,0"
                                                    Background="Transparent" AllowDrop="True"
                                                    PreviewMouseLeftButtonDown="MapLayerNode_PreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="MapLayerNode_PreviewMouseMove"
                                                    DragOver="MapLayerNode_DragOver"
                                                    DragLeave="MapLayerNode_DragLeave"
                                                    Drop="MapLayerNode_Drop">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Only on the layers that have a place in the draw
                                                     order of their own. A sublayer is drawn where the
                                                     service that carries it is drawn. -->
                                                <TextBlock Grid.Column="0" Style="{StaticResource ListRowGrip}"
                                                           Visibility="{Binding CanReorder, Converter={StaticResource BoolToVisibility}}"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <Image Source="{Binding SingleSwatch}" Width="16" Height="16" Margin="0,0,4,0"
                                                           VerticalAlignment="Center" Stretch="Uniform">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SingleSwatch}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DataContext.ShowMapLegend, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                </StackPanel>
                                                <!-- Its own column against the right edge, so the buttons
                                                     line up down the pane instead of each sitting at the
                                                     end of its own layer name.

                                                     Offered on the map's own top level layers only. A
                                                     sublayer is part of the service that carries it and
                                                     cannot be detached from it, so it gets a tick box and
                                                     nothing more. -->
                                                <Button Grid.Column="2" Style="{StaticResource ListRowRemoveButton}"
                                                        Click="RemoveMapLayer_Click"
                                                        ToolTip="Take this layer off the map."
                                                        Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"/>
                                            </Grid>
                                            </Border>

                                            <!-- A layer drawn by category or by range needs a row per
                                                 class, indented under the layer it belongs to. -->
                                            <ItemsControl ItemsSource="{Binding LegendItems}" Margin="22,2,0,2">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding HasLegendList}" Value="True"/>
                                                                    <Condition Binding="{Binding DataContext.ShowMapLegend, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                                            <Image Source="{Binding Swatch}" Width="16" Height="16" Margin="0,0,4,0"
                                                                   VerticalAlignment="Center" Stretch="Uniform"/>
                                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                                       Foreground="#555555" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </DockPanel>
                    </Expander>

                    <GridSplitter Grid.Row="4" x:Name="MapLayersSplitter" Height="5" HorizontalAlignment="Stretch"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                  Background="#E4E4E4" ShowsPreview="True" Cursor="SizeNS" Margin="0,2,0,0"
                                  ToolTip="Drag to give more room to the section above or below."/>

                    <!-- Row 5: data sources, in a row of its own so its height can be dragged. It shared
                         a row with the strip map index before, which kept the two in order but meant
                         neither could be sized against the other. Each section scrolls its own contents,
                         so nothing here scrolls both. -->
                    <Expander Grid.Row="5" x:Name="DataSourcesExpander" Header="Data sources" Margin="0,2,0,0"
                              VerticalContentAlignment="Stretch"
                              Expanded="LeftPaneSection_ExpansionChanged" Collapsed="LeftPaneSection_ExpansionChanged">
                        <StackPanel Margin="4,6,4,4">
                            <!-- The tiles scroll inside this rather than with the pane. Scrolling a long
                                 source list used to carry the whole section with it, taking the Data
                                 sources header off the top of the pane, so there was no way to close the
                                 section from the bottom of its own list. The header now stays put, and
                                 so do the boxes for adding another source underneath. -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding MapDataSources}" Margin="0,0,0,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- One tile per source, drawn as a card so the list reads as a
                                             stack of things that can be picked up and moved rather than
                                             as a run of checkboxes. The order of the tiles is the draw
                                             order on the map: the top tile draws on top.

                                             The whole tile is both the thing dragged and a place to drop
                                             one, so a source is moved by dropping it on the tile whose
                                             place it should take. -->
                                        <Border Margin="0,0,0,2" Padding="4,2,4,2" CornerRadius="3"
                                                Background="#FAFAFA" BorderBrush="#EAEAEA" BorderThickness="1"
                                                AllowDrop="True"
                                                PreviewMouseLeftButtonDown="MapDataSourceTile_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="MapDataSourceTile_PreviewMouseMove"
                                                DragOver="MapDataSourceTile_DragOver"
                                                DragLeave="MapDataSourceTile_DragLeave"
                                                Drop="MapDataSourceTile_Drop">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- The grip. Dragging works from anywhere on the tile that
                                                     is not a control, but a tile that can be moved should
                                                     look like one before it is tried. The same grip the
                                                     map layers tree uses, from the same style. -->
                                                <TextBlock Grid.Column="0" Style="{StaticResource ListRowGrip}"
                                                           Visibility="{Binding CanReorder, Converter={StaticResource BoolToVisibility}}"/>
                                                <StackPanel Grid.Column="1">
                                                    <!-- The name is beside the tick box rather than inside
                                                         it. As the box's content, pressing the name was
                                                         pressing the box, and a press on a control is that
                                                         control's rather than the start of a drag, so the
                                                         most obvious part of the tile to take hold of was
                                                         the one part that would not move.

                                                         Laid out like a row of the map layers tree: tick
                                                         box, then name, and the URL and status only when
                                                         there is one, so a layer that came from the map is
                                                         the same single line there as it is here. -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                  ToolTip="Draw this source on the map."/>
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Url}" Style="{StaticResource ListRowSubText}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Status}" Style="{StaticResource ListRowSubText}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource ListRowRemoveButton}"
                                                        ToolTip="Take this source off the map."
                                                        Command="{Binding DataContext.RemoveMapDataSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="Drag a tile onto another to change the draw order. The top tile draws over the ones below it."
                                       Foreground="#777777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="Add a MapServer, FeatureServer layer, VectorTileServer or KML URL" Foreground="#777777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,4">
                                <TextBox x:Name="NewMapDataSourceNameBox" Text="{Binding NewMapDataSourceName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Display name (optional). Leave it empty to name the source from its service URL."/>
                                <TextBlock Text="Display name (optional)">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FieldPlaceholder}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=NewMapDataSourceNameBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <TextBox x:Name="NewMapDataSourceUrlBox" Text="{Binding NewMapDataSourceUrl, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Service URL, for example https://host/arcgis/rest/services/MA/Landbase_MA/MapServer"/>
                                <TextBlock Text="Service URL">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FieldPlaceholder}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=NewMapDataSourceUrlBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Content="Add data source" Command="{Binding AddMapDataSourceCommand}" Padding="8,2" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Expander>

                    <GridSplitter Grid.Row="6" x:Name="DataSourcesSplitter" Height="5" HorizontalAlignment="Stretch"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                  Background="#E4E4E4" ShowsPreview="True" Cursor="SizeNS" Margin="0,2,0,0"
                                  ToolTip="Drag to give more room to the section above or below."/>

                    <!-- The last row, directly below data sources. Collapsed by default, so it takes
                         only its header until opened.

                         Hidden entirely for the visible map viewport method: the index lays a run of
                         sheets along a proposed main, and that method has no proposed main to lay them
                         along. An Auto row with a collapsed child in it leaves no gap behind. -->
                    <Expander Grid.Row="7" x:Name="StripMapExpander" Header="Strip map index" Margin="0,2,0,0"
                              VerticalContentAlignment="Stretch"
                              Expanded="LeftPaneSection_ExpansionChanged" Collapsed="LeftPaneSection_ExpansionChanged">
                        <Expander.Style>
                            <Style TargetType="Expander">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrentDrawingViewMethod}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                            <!-- Its own scroller, capped, so a long settings list stays inside this
                                 section instead of pushing the pane past its bottom. Nothing here
                                 scrolls the data sources above it. -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="4,6,4,4">
                                <TextBlock Text="Lays a run of sheets along the proposed main, each covering what one viewport shows at the plot scale."
                                           TextWrapping="Wrap" Foreground="#555555" Margin="0,0,0,8"/>

                                <TextBlock Text="Viewport from the CAD template" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding StripMapViewports}"
                                          SelectedItem="{Binding SelectedStripMapViewport}"
                                          DisplayMemberPath="Display"
                                          Margin="0,0,0,4"
                                          ToolTip="Paper space viewports found in the template picked on page 1, or in the open drawing when no template is set. Choosing one fills the sheet size below."/>
                                <TextBlock Text="No viewports found. Pick a template on page 1, or type a sheet size below."
                                           Foreground="#777777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StripMapViewports.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="Sheet size" FontWeight="SemiBold" Margin="0,4,0,4"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Along route" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding StripMapSheetWidth, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"
                                             ToolTip="Viewport width in paper units. This side of the sheet runs along the pipeline."/>
                                    <TextBlock Grid.Column="2" Text="Across" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding StripMapSheetHeight, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Viewport height in paper units. This side of the sheet runs across the pipeline."/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton Content="inches" GroupName="StripMapUnits" IsChecked="{Binding StripMapSheetIsInches}" Margin="0,0,10,0"/>
                                    <RadioButton Content="millimetres" GroupName="StripMapUnits" IsChecked="{Binding StripMapSheetIsMillimetres}"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Scale  1:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding StripMapScaleDenominator, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"
                                             ToolTip="Plot scale denominator. 240 gives 1:240, one paper inch to twenty feet."/>
                                    <TextBlock Grid.Column="2" Text="Overlap %" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding StripMapOverlapPercent, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="How much of each sheet repeats on the next one, so a feature on a sheet edge is not cut in half on both."/>
                                </Grid>

                                <TextBlock Text="{Binding StripMapGroundSizeText}" Foreground="#555555" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="Build index" Click="BuildStripMapIndex_Click" Padding="8,2" Margin="0,0,6,0"/>
                                    <Button Content="Clear" Click="ClearStripMapIndex_Click" Padding="8,2"/>
                                </StackPanel>

                                <TextBlock Text="{Binding StripMapSummary}" Foreground="#555555" TextWrapping="Wrap"/>
                            </StackPanel>
                            </ScrollViewer>
                    </Expander>
                </Grid>
                <Grid Grid.Column="2">
                    <!-- The map and the attribute table both take a share of what is left, so the
                         splitter between them moves the boundary rather than one of them winning.
                         Row 3 goes back to Auto while the table is closed, so a closed table is its
                         header and the map has the rest. -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="ExtentMapRow" Height="2*" MinHeight="160"/>
                        <RowDefinition Height="Auto"/>
                        <!-- Starts given back rather than starred. There is nothing in the table until
                             a segment is drawn, and a starred row with a minimum on it took a share of
                             the page for a section that was not on screen, so the map opened shorter
                             than it could be. The row is switched to a share the moment the first row
                             appears. -->
                        <RowDefinition x:Name="ProposedMainAttributeRow" Height="Auto" MinHeight="0"/>
                    </Grid.RowDefinitions>
                    <!-- LastChildFill off. On by default it hands the whole remaining width to the last
                         child whatever its Dock says, so the address controls were laid out from the
                         left edge of that space and ended up pressed against the end of the title. Off,
                         the right dock is honoured: the title stays left, the controls sit right, and
                         the space between them is the gap. -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                        <TextBlock x:Name="ExtentModeTitle" Text="Native ArcGIS Maps SDK MapView" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="24,0,0,0">
                            <TextBlock Text="Address:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="AddressSearchTextBox" Width="380" Margin="0,0,6,0" KeyDown="AddressSearchTextBox_KeyDown"/>
                            <Button Content="Go 1:960" Click="GoToAddress_Click" Padding="8,2" Margin="0,0,4,0"/>
                            <Button Content="Reset MA" Click="ResetMapView_Click" Padding="8,2"/>
                        </StackPanel>
                    </DockPanel>
                    <!-- The map and the tool panel share the map's row. The panel is a fixed width
                         against the right edge of the map rather than a column of the page, so the
                         attribute table underneath still runs the full width. -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="#A0A0A0" BorderThickness="1" Background="#F5F5F5">
                            <ContentControl x:Name="ArcGisMapHost"/>
                        </Border>

                        <!-- One section per layer, each collapsible. There is one layer today and there
                             will be more, so a panel that showed every symbol of every layer at once
                             would become a wall rather than a tool. -->
                        <Border Grid.Column="1" Width="210" Margin="6,0,0,0" BorderBrush="#A0A0A0"
                                BorderThickness="1" Background="#FCFCFC">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Place from GIS" FontWeight="Bold" Margin="6,6,6,2"/>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding PalettePlacementStatus}"
                                           Foreground="#555555" FontSize="11" TextWrapping="Wrap" Margin="6,0,6,6"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding SymbolPalettes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Expander Header="{Binding Name}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                          Margin="4,0,4,4">
                                                    <StackPanel Margin="4,4,0,4">
                                                        <TextBlock Text="{Binding Status}" Foreground="#A03030" FontSize="11"
                                                                   TextWrapping="Wrap" Margin="0,0,0,4"
                                                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}"/>
                                                        <ItemsControl ItemsSource="{Binding Symbols}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <!-- A button, so a symbol is picked the way
                                                                         anything else is picked, and the armed
                                                                         one is outlined so the map's next click
                                                                         is never a guess. -->
                                                                    <Button Click="SymbolPaletteItem_Click" HorizontalContentAlignment="Left"
                                                                            Padding="4,2" Margin="0,0,0,2" BorderThickness="1"
                                                                            ToolTip="{Binding Label}">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button">
                                                                                <Setter Property="Background" Value="Transparent"/>
                                                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                        <Setter Property="Background" Value="#EAF3FB"/>
                                                                                        <Setter Property="BorderBrush" Value="#1E6FB8"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Image Source="{Binding Swatch}" Width="18" Height="18"
                                                                                   Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                            <!-- Drawn from the symbol's colour when the
                                                                                 service described it without a picture,
                                                                                 so every entry has something to look at. -->
                                                                            <Rectangle Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                                       Fill="{Binding Fallback}">
                                                                                <Rectangle.Style>
                                                                                    <Style TargetType="Rectangle">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Swatch}" Value="{x:Null}">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Rectangle.Style>
                                                                            </Rectangle>
                                                                            <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Under the map rather than in the left pane, because a row per segment and a
                         column per GIS field is a wide thing and the left pane is a column of narrow
                         ones. Closed it is just its header, so the map keeps its height until the
                         table is wanted. -->
                    <!-- Only there when the table is. A drag bar under the map with nothing beneath it
                         is an invitation to resize something that is not on screen. -->
                    <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                  Background="#E4E4E4" ShowsPreview="True" Cursor="SizeNS"
                                  ToolTip="Drag to give more room to the map or to the attribute table."
                                  Visibility="{Binding HasProposedMainAttributes, Converter={StaticResource BoolToVisibility}}"/>

                    <Expander Grid.Row="3" x:Name="ProposedMainAttributeSection" Margin="0,6,0,0"
                              Expanded="ProposedMainAttributeSection_ExpansionChanged"
                              Collapsed="ProposedMainAttributeSection_ExpansionChanged"
                              SizeChanged="ProposedMainAttributeSection_SizeChanged"
                              Header="Proposed main attributes" IsExpanded="True"
                              Visibility="{Binding HasProposedMainAttributes, Converter={StaticResource BoolToVisibility}}">
                        <!-- A Grid rather than a StackPanel. A StackPanel offers its children unlimited
                             height, and a DataGrid asked how tall it would like to be answers with
                             however many rows it has, which is how the map ends up with whatever is
                             left. The table now fills the row it is given, so the splitter above
                             decides its height. -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Kept as a panel rather than a bare TextBlock because the table's height
                                 is measured from it. -->
                            <DockPanel Grid.Row="0" x:Name="ProposedMainAttributeHeaderPanel" Margin="4,4,4,6" LastChildFill="True">
                                <TextBlock Text="{Binding ProposedMainAttributeStatus}" Foreground="#555555"
                                           TextWrapping="Wrap"/>
                            </DockPanel>

                            <!-- No columns declared here: they are built in code from the layer's own
                                 fields, because which fields exist is GIS's to decide and a copy
                                 written into the XAML would be one that goes stale. -->
                            <!-- Whole rows, not cells: selecting a row is what picks the segment out on
                                 the map, and a cell selection has no row to report. Cells are still
                                 edited by clicking into them. Both scrollbars are on: the table opens
                                 at the height its rows want, and past the cap it scrolls rather than
                                 taking the map's space. -->
                            <DataGrid Grid.Row="1" x:Name="ProposedMainAttributeGrid"
                                      ItemsSource="{Binding ProposedMainSegmentRows}"
                                      SelectionChanged="ProposedMainAttributeGrid_SelectionChanged"
                                      PreviewKeyDown="ProposedMainAttributeGrid_PreviewKeyDown"
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="All"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      Margin="4,0,4,4"/>

                            <CheckBox Grid.Row="2" x:Name="ProposedMainUploadCheckBox" IsChecked="{Binding UploadProposedMainToGis}" Margin="4,4,4,4"
                                      Content="Add these segments to the GIS proposed main layer on the way to page 3"
                                      ToolTip="The only thing this application writes to GIS. Untick to draw and export without adding anything."/>
                        </Grid>
                    </Expander>
                </Grid>
            </Grid>
                        <Grid x:Name="LayerPage" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <GroupBox Header="Layers" Grid.Column="0">
                    <ListBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="4">
                                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding GeometryType}" Foreground="Gray" FontSize="11"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>
                <GroupBox Header="Fields for selected layer" Grid.Column="2">
                    <DataGrid ItemsSource="{Binding SelectedLayer.Fields}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Export" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn Header="Field" Binding="{Binding Name}" IsReadOnly="True" Width="200"/>
                            <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" IsReadOnly="True" Width="260"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
            <Grid x:Name="TransformPage" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <GroupBox Header="Layer transformation rules" Grid.Column="0">
                    <ListBox ItemsSource="{Binding TransformRules}" SelectedItem="{Binding SelectedTransform}" DisplayMemberPath="LayerNameWithGeometry"/>
                </GroupBox>
                <GroupBox Header="CAD import behavior" Grid.Column="2">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Where blocks and line types are read from. A template usually holds the
                             standard symbols the export is meant to match, which the drawing in
                             progress may not have yet. -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Symbols from" Margin="0,0,8,8"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton Content="Open drawing" IsChecked="{Binding UseDrawingSymbols, Mode=TwoWay}" GroupName="SymbolSource" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <RadioButton Content="CAD template (.dwt)" IsChecked="{Binding UseTemplateSymbols, Mode=TwoWay}" GroupName="SymbolSource" IsEnabled="{Binding HasTemplate}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <Button Content="Reload" Click="ReloadCadCatalog_Click" Padding="8,2"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Feature type" Margin="0,0,8,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTransform.GeometryDisplay}" Foreground="#555555" VerticalAlignment="Center" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="CAD Layer Name" Margin="0,0,8,8"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTransform.CadLayerName, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding CadLayers}" IsEditable="True" Margin="0,0,0,8"/>

                        <!-- Point only: points are drawn as block references. -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Point Block" Margin="0,0,8,8"
                                   Visibility="{Binding SelectedTransform.IsPoint, Converter={StaticResource BoolToVisibility}}"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8"
                                    Visibility="{Binding SelectedTransform.IsPoint, Converter={StaticResource BoolToVisibility}}">
                            <ComboBox Width="260" Text="{Binding SelectedTransform.BlockName, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Blocks}" IsEditable="True" Margin="0,0,6,0"/>
                            <Button Content="Edit block" Click="EditBlock_Click" Padding="8,2" ToolTip="Opens the selected block in the AutoCAD block editor."/>
                        </StackPanel>

                        <!-- Line and polygon only: both are drawn as polylines. -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Line Type" Margin="0,0,8,8"
                                   Visibility="{Binding SelectedTransform.IsLine, Converter={StaticResource BoolToVisibility}}"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedTransform.LineType, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding LineTypes}" IsEditable="True" Margin="0,0,0,8"
                                  Visibility="{Binding SelectedTransform.IsLine, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Color Mode" Margin="0,0,8,8"/>
                        <ComboBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedTransform.ColorMode, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,0,0,8">
                            <ComboBoxItem Content="ByLayer"/>
                            <ComboBoxItem Content="ACI"/>
                            <ComboBoxItem Content="RGB"/>
                        </ComboBox>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Color" Margin="0,0,8,8"/>
                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="28" Height="20" BorderBrush="#808080" BorderThickness="1" Margin="0,0,6,0"
                                    Background="{Binding SelectedTransform.ColorPreview, TargetNullValue=Transparent, FallbackValue=Transparent}"/>
                            <TextBlock Text="{Binding SelectedTransform.ColorDescription}" VerticalAlignment="Center" MinWidth="104" Margin="0,0,6,0" Foreground="#555555"/>
                            <Button Content="Pick color..." Click="PickColor_Click" Padding="8,2" Margin="0,0,6,0"
                                    ToolTip="Opens the AutoCAD color dialog, with the index, true color and color book tabs."/>
                            <TextBlock Text="ACI" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#555555"
                                       Visibility="{Binding SelectedTransform.IsAciColor, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBox Width="60" Text="{Binding SelectedTransform.AciColor, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding SelectedTransform.IsAciColor, Converter={StaticResource BoolToVisibility}}"
                                     ToolTip="The ACI index, if you would rather type it than pick it. Hidden for a true color, where the index no longer describes the color."/>

                            <!-- The true color equivalent of the ACI box: an index says nothing about a
                                 true color, so the RGB is what has to be readable and editable here. -->
                            <TextBlock Text="RGB" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#555555"
                                       Visibility="{Binding SelectedTransform.IsRgbColor, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBox Width="84" Text="{Binding SelectedTransform.RgbColor, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding SelectedTransform.IsRgbColor, Converter={StaticResource BoolToVisibility}}"
                                     ToolTip="The true color as #RRGGBB. Type one here, or use Pick color and the dialog's True Color tab."/>
                        </StackPanel>

                        <!-- Point only: rotation and scale apply to a block reference. -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Rotation" Margin="0,0,8,8"
                                   Visibility="{Binding SelectedTransform.IsPoint, Converter={StaticResource BoolToVisibility}}"/>
                        <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,0,0,8"
                                    Visibility="{Binding SelectedTransform.IsPoint, Converter={StaticResource BoolToVisibility}}">
                            <RadioButton GroupName="RotationSource" IsChecked="{Binding SelectedTransform.UseFieldRotation}"
                                         Content="From a GIS field" Margin="0,0,0,4"
                                         ToolTip="Each block is turned by its own feature's value. A feature with no value falls back to the fixed degrees below."/>
                            <StackPanel Margin="20,0,0,6" IsEnabled="{Binding SelectedTransform.UseFieldRotation}">
                                <ComboBox ItemsSource="{Binding SelectedTransform.AvailableFields}"
                                          Text="{Binding SelectedTransform.RotationField, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True" Margin="0,0,0,4"
                                          ToolTip="The layer's own fields. One that looks like a rotation is filled in for you; anything you choose here replaces it and is kept."/>
                                <CheckBox Content="Invert rotation" IsChecked="{Binding SelectedTransform.InvertRotationField}"
                                          ToolTip="For a layer that measures its angle the opposite way round from AutoCAD. Tick this when the symbols lean the wrong way; use the degrees below if they are simply facing the wrong end."/>
                            </StackPanel>
                            <RadioButton GroupName="RotationSource" IsChecked="{Binding SelectedTransform.UseFixedRotation}"
                                         Content="Fixed for every block" Margin="0,0,0,4"
                                         ToolTip="Ignores the data and places every block at the degrees below. 0 keeps them horizontal, 90 stands them up."/>
                            <StackPanel Orientation="Horizontal" Margin="20,0,0,6">
                                <TextBlock Text="Degrees" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Width="80" Text="{Binding SelectedTransform.RotationOffsetDegrees, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="The whole rotation when fixed. Added on top of the field's value otherwise, so a layer that is right about the axis but a quarter turn out can be corrected once."/>
                                <TextBlock Text="0 = horizontal, 90 = vertical" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#777777"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedTransform.RotationSummary}" TextWrapping="Wrap" Foreground="#555555"/>
                        </StackPanel>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Block Scale" Margin="0,0,8,8"
                                   Visibility="{Binding SelectedTransform.IsPoint, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding SelectedTransform.ScaleValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                 Visibility="{Binding SelectedTransform.IsPoint, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- Polygon only: a fill says the inside belongs to something, which is only a
                             reading an area layer has. -->
                        <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
                                    Visibility="{Binding SelectedTransform.IsPolygon, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox Content="Fill polygons with a hatch" IsChecked="{Binding SelectedTransform.HatchPolygons}"
                                      FontWeight="SemiBold" Margin="0,4,0,4"
                                      ToolTip="Draws a hatch inside each polygon as well as its outline. The outline is always written; this adds the fill."/>
                            <StackPanel Margin="20,0,0,0" IsEnabled="{Binding SelectedTransform.HatchPolygons}">
                                <TextBlock Text="Pattern" Margin="0,0,0,4"/>
                                <ComboBox Width="180" HorizontalAlignment="Left" IsEditable="True"
                                          ItemsSource="{Binding SelectedTransform.HatchPatterns}"
                                          Text="{Binding SelectedTransform.HatchPattern, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          ToolTip="A pattern AutoCAD ships with. SOLID fills the area; the others draw lines and need a spacing that suits the plot scale."/>

                                <StackPanel Visibility="{Binding SelectedTransform.HatchScaleApplies, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Pattern spacing" Margin="0,0,0,4"/>
                                    <TextBox Width="180" HorizontalAlignment="Left"
                                             Text="{Binding SelectedTransform.HatchScale, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                                             ToolTip="Multiplies the pattern's line spacing. Too small on a large area draws as a solid block and takes a long time; too large draws nothing visible."/>
                                </StackPanel>

                                <!-- Outside the pattern block: an inset means the same for a solid fill
                                     as for a line pattern. -->
                                <TextBlock Text="Inset from boundary (drawing units)" Margin="0,0,0,4"/>
                                <TextBox Width="180" HorizontalAlignment="Left"
                                         Text="{Binding SelectedTransform.HatchInsetDistance, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                                         ToolTip="Fills a smaller polygon offset inwards from the boundary, the same as OFFSET on a closed polyline. Zero fills right up to the outline."/>
                                <TextBlock Text="The fill stops short of the outline, so the boundary reads as a line in its own right instead of being buried under the edge of its own hatch. An inset wider than the polygon can absorb leaves nothing to fill, and is reported rather than drawn. An inset fill does not follow later edits to the boundary, since there is no drawn boundary to follow."
                                           TextWrapping="Wrap" Foreground="#777777" FontSize="11" Margin="0,0,0,6"/>

                                <TextBlock Text="Transparency %" Margin="0,0,0,4"/>
                                <TextBox Width="180" HorizontalAlignment="Left"
                                         Text="{Binding SelectedTransform.HatchTransparencyPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                                         ToolTip="0 is opaque, 90 is nearly invisible. The default leaves the fill see-through, so it shows what a polygon covers without hiding the features underneath it."/>
                                <TextBlock Text="The fill follows its outline, so stretching the boundary in CAD restretches the hatch with it."
                                           TextWrapping="Wrap" Foreground="#777777" FontSize="11" Margin="0,0,0,8"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </Grid>
            <Grid x:Name="ReviewPage" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Review + Export Plan" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding ResolvedExtentText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Drawing coordinates: " Foreground="#555555"/>
                        <TextBlock Text="{Binding OutputSpatialReferenceText}" Foreground="#555555" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="Build Dry-Run Export Plan" Command="{Binding BuildReviewCommand}" Width="220" Padding="8" Margin="0,0,10,0"
                                ToolTip="Writes export-plan-latest.json describing what would be exported, without touching the drawing."/>
                        <Button Content="Export to CAD" Command="{Binding ExportCommand}" Width="160" Padding="8" FontWeight="SemiBold"
                                ToolTip="Fetches the selected layers and writes them into the open drawing."/>
                    </StackPanel>

                    <TextBlock Text="Export writes into the drawing that is open, in one transaction: if any part fails, nothing is written. Each GIS layer becomes a CAD layer named by its rule on page 4."
                               TextWrapping="Wrap" Foreground="#555555" Margin="0,0,0,10"/>

                    <TextBlock Text="Strip map index layer" FontWeight="SemiBold" Margin="0,6,0,4"/>
                    <TextBox Text="{Binding StripMapCadLayerName, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left"
                             ToolTip="The CAD layer the strip map sheet frames and their numbers are drawn on. Kept separate from the GIS layers, because the index describes the sheet set rather than anything in the ground."/>
                    <TextBlock Text="Sheet frames go on this layer only, so they can be turned off or plotted on their own. Nothing is written here unless a strip map index has been built on page 2, and nothing is written for a visible map viewport export, which has no proposed main to lay sheets along."
                               TextWrapping="Wrap" Foreground="#777777" FontSize="11" Margin="0,4,0,0"/>

                    <Separator Margin="0,16,0,12"/>

                    <CheckBox Content="Attach the selected attributes to each entity" IsChecked="{Binding AttachAttributesToEntities}"
                              FontWeight="SemiBold" Margin="0,0,0,6"
                              ToolTip="Writes the fields ticked on page 3 onto each entity as extended data, so a line in the drawing carries what the GIS knew about it."/>
                    <StackPanel Margin="20,0,0,0" IsEnabled="{Binding AttachAttributesToEntities}">
                        <TextBlock Text="Filed under" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding AttributeAppName, UpdateSourceTrigger=PropertyChanged}" Width="180" HorizontalAlignment="Left"
                                 ToolTip="The application name the data is stored against, so it can be found again and so another tool writing to the same entity does not overwrite it."/>
                        <TextBlock Text="A polyline on its own says where something runs; carrying its diameter, material and work order it says what it is. AutoCAD shows this under Properties, and any tool reading the drawing can pick it up, so nothing has to go back to the GIS to identify a line. Values longer than 255 characters are shortened to fit what extended data allows."
                                   TextWrapping="Wrap" Foreground="#777777" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Separator Margin="0,16,0,12"/>

                    <CheckBox Content="Include the export boundary as a layer" IsChecked="{Binding IncludeBoundaryInExport}"
                              FontWeight="SemiBold" Margin="0,0,0,6"
                              ToolTip="Draws the shape that decided which features were fetched, as a closed polyline."/>
                    <TextBlock Text="{Binding BoundaryDescription}" TextWrapping="Wrap" Foreground="#555555" Margin="20,0,0,6"/>
                    <StackPanel Margin="20,0,0,0" IsEnabled="{Binding IncludeBoundaryInExport}">
                        <TextBlock Text="Export boundary CAD layer" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding BoundaryCadLayerName, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left"
                                 ToolTip="The boundary goes on this layer alone, so the area you worked to can be switched off when the drawing is issued."/>
                        <TextBlock Text="Which shape scopes the export follows the method chosen on page 1: a work order or a drawn pipeline is scoped to the padding buffer around the main, and the current drawing view or a typed extent to the bounding box. Everything intersecting that shape is imported. On a corridor job the extent rectangle is never drawn, only the buffer; where a buffer is called for but the padding is zero, the box is used to fetch, nothing is drawn, and the status line says so."
                                   TextWrapping="Wrap" Foreground="#777777" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Separator Margin="0,16,0,12"/>

                    <CheckBox Content="Include a basemap image in the drawing" IsChecked="{Binding IncludeBasemapInExport}"
                              FontWeight="SemiBold" Margin="0,0,0,6"
                              ToolTip="Downloads the basemap over the export extent and places it, georeferenced, behind the features."/>
                    <TextBlock Text="Off by default, because AutoCAD's own geographic map is switched on after every export and shows where the features landed without writing anything. Tick this instead when the backdrop has to travel with the drawing to someone who cannot fetch a map themselves: it writes a real image file beside the profile which the drawing then references by path, so moving or deleting that file leaves the drawing with a missing reference."
                               TextWrapping="Wrap" Foreground="#777777" FontSize="11" Margin="20,0,0,8"/>

                    <StackPanel Margin="20,0,0,0" IsEnabled="{Binding IncludeBasemapInExport}">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Basemap" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ExportBasemapChoices}"
                                      SelectedItem="{Binding SelectedExportBasemap}" DisplayMemberPath="Name" Margin="0,0,12,0"
                                      ToolTip="Cached ArcGIS Online services, which answer without a portal sign-in."/>
                            <TextBlock Grid.Column="2" Text="Image px" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="3" Text="{Binding BasemapImagePixels, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Long edge of the image. More is sharper and larger; a service will not return over 4096 and does not say when it clamps."/>
                        </Grid>

                        <TextBlock Text="Basemap CAD layer" Margin="0,4,0,4"/>
                        <TextBox Text="{Binding BasemapCadLayerName, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left" Margin="0,0,0,8"
                                 ToolTip="The raster goes on this layer alone and is sent to the back of the draw order, so it can be turned off without touching the features."/>

                        <Grid Margin="0,0,0,4">
                            <TextBox x:Name="CustomBasemapUrlBox" Text="{Binding CustomBasemapUrl, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="A MapServer URL to use instead of the list above, for a basemap your organisation publishes. Takes precedence over the dropdown when filled in."/>
                            <TextBlock Text="Custom basemap MapServer URL (optional)">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FieldPlaceholder}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=CustomBasemapUrlBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button Content="Back" Command="{Binding BackCommand}" Width="100" Margin="0,0,8,0"/>
            <Button Content="Next" Command="{Binding NextCommand}" Width="100" Margin="0,0,8,0"/>
            <Button Content="Export / Build Plan" Command="{Binding ExportCommand}" Width="160"/>
        </DockPanel>
        <!-- A read only TextBox rather than a TextBlock, because this is where the error messages land
             and a TextBlock cannot be selected: every code in it had to be copied out by retyping it.
             Styled to look like the label it replaces: no border, no box background, and the caret
             left visible so it is obvious the text can be picked up. -->
        <Border Grid.Row="3" Margin="0,10,0,0" Padding="8" Background="#F1F1F1" BorderBrush="#D0D0D0" BorderThickness="1">
            <TextBox Text="{Binding Status, Mode=OneWay}" TextWrapping="Wrap"
                     IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     BorderThickness="0" Background="Transparent" Padding="0"
                     MaxHeight="120" VerticalScrollBarVisibility="Auto"
                     ToolTip="Select any part of this and press Ctrl+C to copy it."/>
        </Border>
    </Grid>
</Window>
