<Window x:Class="NG.GIS.CAD.Exporter.Views.ExporterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="National Grid GIS CAD Exporter" Height="760" Width="1180">
    <Window.Resources>
        <!-- Placeholder text shown inside an empty field. Sits over the TextBox rather than
             retemplating it, so the box keeps its normal focus and hover chrome. Hit testing is off
             so clicks land on the field underneath. -->
        <Style x:Key="FieldPlaceholder" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9A9A"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="Bold" Width="280"/>
            <TextBox Text="{Binding ProfilePath, UpdateSourceTrigger=PropertyChanged}" MinWidth="560" Margin="0,0,8,0"/>
            <Button Content="Load Profile" Command="{Binding LoadProfileCommand}" Margin="0,0,8,0" Padding="12,4"/>
            <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Padding="12,4"/>
        </DockPanel>
        <Grid Grid.Row="1">
                                                                                    <Grid x:Name="MethodPage">
                <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                    <TextBlock Text="Export method" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                    <RadioButton x:Name="WorkOrderDrivenExportRadio" Content="Work Order driven export" IsChecked="True" Checked="ExportDisplayMode_Checked" Margin="0,0,0,8"/>
                    <RadioButton x:Name="ManualProposedPipelineRadio" Content="Manual proposed pipeline segments" Checked="ExportDisplayMode_Checked" Margin="0,0,0,8"/>
                    <RadioButton x:Name="VisibleMapExportRadio" Content="Visible map viewport export" Checked="ExportDisplayMode_Checked" Margin="0,0,0,18"/>
                    <TextBlock Text="Work order lookup from NG_ODS" FontSize="16" FontWeight="Bold" Margin="0,12,0,8"/>
                    <TextBlock Text="Work Order Number"/>
                    <ComboBox x:Name="WorkOrderSelectionComboBox" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" DisplayMemberPath="WorkOrderNumberDisplay" Loaded="NgOdsWorkOrderCombos_Loaded" DropDownOpened="NgOdsWorkOrderNumberCombo_DropDownOpened" KeyUp="NgOdsWorkOrderNumberCombo_KeyUp" SelectionChanged="NgOdsWorkOrderNumberCombo_SelectionChanged" LostFocus="NgOdsWorkOrderCombo_LostFocus" Margin="0,0,0,8"/>
                    <TextBlock Text="Work Order Name"/>
                    <ComboBox x:Name="WorkOrderNameComboBox" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" DisplayMemberPath="WorkOrderNameDisplay" Loaded="NgOdsWorkOrderCombos_Loaded" DropDownOpened="NgOdsWorkOrderNameCombo_DropDownOpened" KeyUp="NgOdsWorkOrderNameCombo_KeyUp" SelectionChanged="NgOdsWorkOrderNameCombo_SelectionChanged" LostFocus="NgOdsWorkOrderCombo_LostFocus" Margin="0,0,0,8"/>
                    <TextBlock Text="Padding ft (applies to Work Order driven export and Manual proposed pipeline segments)"/>
                    <TextBox x:Name="WorkOrderPaddingTextBox" Text="{Binding PaddingFeet, UpdateSourceTrigger=PropertyChanged}" TextChanged="PaddingInput_TextChanged" Margin="0,0,0,12"/>
                    <TextBlock Text="The full NG_ODS work order query loads once when this page opens, then both dropdowns filter locally. Selecting either Work Order Number or Work Order Name updates the other dropdown from the same NG_ODS row." TextWrapping="Wrap" Foreground="#555555"/>
                    <TextBlock Text="CAD template (.dwt)" FontSize="16" FontWeight="Bold" Margin="0,18,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="Pick .dwt" Click="PickLocalDwtTemplate_Click" Width="80" Height="24" Margin="0,0,5,0"/>
                        <TextBox x:Name="LocalDwtPathTextBox" Width="440" Height="24" IsReadOnly="True" Margin="0,0,5,0"/>
                        <Button Content="Open" Click="OpenLocalDwtTemplate_Click" Width="70" Height="24"/>
                    </StackPanel>
                    <TextBlock x:Name="LocalDwtStatusText" Text="Select a local or synced .dwt, or sign in below to browse SharePoint." TextWrapping="Wrap" Foreground="#555555"/>
                    <Expander x:Name="SharePointTemplatesExpander" Header="SharePoint templates" Margin="0,8,0,0" Expanded="SharePointTemplates_Expanded">
                        <StackPanel Margin="4,6,4,4">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button x:Name="SharePointSignInButton" Content="Sign in to SharePoint" Click="SharePointSignIn_Click" Padding="8,2" Margin="0,0,6,0"/>
                                <Button x:Name="SharePointRefreshButton" Content="Refresh list" Click="SharePointRefresh_Click" Padding="8,2" Margin="0,0,6,0"/>
                                <Button x:Name="SharePointSignOutButton" Content="Sign out" Click="SharePointSignOut_Click" Padding="8,2"/>
                            </StackPanel>
                            <ListBox x:Name="SharePointTemplateList" Height="120" DisplayMemberPath="Name" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SharePointUseButton" Content="Download and use" Click="SharePointUseSelected_Click" Padding="8,2" Margin="0,0,6,0"/>
                                <TextBlock x:Name="SharePointStatusText" Text="Not signed in." VerticalAlignment="Center" Foreground="#555555" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Grid>
                        <Grid x:Name="ExtentPage" Visibility="Collapsed" IsVisibleChanged="ExtentPage_IsVisibleChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <!-- Splitters let each section below the mode buttons be resized. The rows keep
                         their original sizing, so the pane opens looking the same and only changes
                         when dragged. Minimum heights stop a section being collapsed to nothing. -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="80"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="80"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto" MinHeight="30"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                    <StackPanel x:Name="WorkOrderModePanel">
                        <TextBlock Text="Work Order driven export" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Button Content="Refresh Work Order Geometry + Buffer" Click="RefreshWorkOrderGeometry_Click" Padding="8" Margin="0,0,0,10"/>
                                                <UniformGrid Columns="3" Margin="0,0,0,10">
                            <Button Content="Edit Imported Main" Click="EditImportedProposedMain_Click" Padding="8" Margin="0,0,4,0"/>
                            <Button Content="Apply Segment" Click="ApplyManualProposedMainSegment_Click" Padding="8" Margin="4,0,4,0"/>
                            <Button Content="Cancel Edit" Click="CancelImportedProposedMainEdit_Click" Padding="8" Margin="4,0,0,0"/>
                        </UniformGrid>                        <TextBlock Text="Manual proposed pipeline segments" FontWeight="Bold" Margin="0,8,0,6"/>
                        <UniformGrid Columns="4" Margin="0,0,0,10">
                        <Button Content="Start Segment" Click="StartManualProposedMainSegment_Click" Padding="8" Margin="0,0,4,0"/>
                            <Button Content="Apply Segment" Click="ApplyManualProposedMainSegment_Click" Padding="8" Margin="4,0,4,0"/>
                        <Button Content="Finish Segments" Click="FinishManualProposedMainSegments_Click" Padding="8" Margin="4,0,4,0"/>
                            <Button Content="Clear Segments" Click="ClearManualProposedMainSegments_Click" Padding="8" Margin="4,0,0,0"/>
                        </UniformGrid>
                        <TextBlock Text="Work order geometry/buffer proof" FontWeight="Bold" Margin="0,10,0,6"/>
                        <TextBox x:Name="WorkOrderGeometryTextBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="170" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="0,0,0,16"/>
                        <TextBlock Text="This view is controlled by the first page. Change WO number, padding, or method on page 1." TextWrapping="Wrap" Foreground="#555555"/>
                    </StackPanel>
                    <StackPanel x:Name="ManualProposedPipelineModePanel" Visibility="Collapsed">
                        <TextBlock Text="Manual proposed pipeline segments" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="Padding from Page 1 is applied as a buffer around all manual proposed pipeline segments." TextWrapping="Wrap" Foreground="#555555" Margin="0,0,0,8"/>
                        <UniformGrid Columns="4" Margin="0,0,0,10">
                            <Button Content="Start Segment" Click="StartManualProposedMainSegment_Click" Padding="8" Margin="0,0,4,0"/>
                            <Button Content="Apply Segment" Click="ApplyManualProposedMainSegment_Click" Padding="8" Margin="4,0,4,0"/>
                            <Button Content="Finish Segments" Click="FinishManualProposedMainSegments_Click" Padding="8" Margin="4,0,4,0"/>
                            <Button Content="Clear Manual" Click="ClearManualProposedMainSegments_Click" Padding="8" Margin="4,0,0,0"/>
                        </UniformGrid>
                        <TextBox x:Name="ProposedPipelineTextBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas" MinHeight="220" Margin="0,0,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="VisibleMapModePanel" Visibility="Collapsed">
                        <TextBlock Text="Visible map viewport export" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Button Content="Commit Visible Map Extent" Click="SetExtentFromVisibleMap_Click" Padding="8" Margin="0,0,0,16"/>
                        <TextBlock Text="Live MapView extent (updates after pan/zoom)" FontWeight="Bold" Margin="0,10,0,6"/>
                        <TextBox x:Name="CapturedExtentTextBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="190" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="0,0,0,16"/>
                    </StackPanel>
                    </Grid>
                    </ScrollViewer>
                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                  Background="#E4E4E4" ShowsPreview="True" Cursor="SizeNS"
                                  ToolTip="Drag to resize the panel above and the map layers below"/>
                    <GroupBox Grid.Row="2" Header="Map layers" Margin="0,4,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,4,6">
                                <Button Content="Expand all" Click="ExpandAllMapLayers_Click" Padding="8,2" Margin="0,0,6,0"/>
                                <Button Content="Collapse all" Click="CollapseAllMapLayers_Click" Padding="8,2"/>
                            </StackPanel>
                            <TreeView ItemsSource="{Binding MapLayers}" BorderThickness="0" Background="Transparent"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalContentAlignment="Center" Margin="0,2,0,2"/>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </DockPanel>
                    </GroupBox>
                    <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                  Background="#E4E4E4" ShowsPreview="True" Cursor="SizeNS"
                                  ToolTip="Drag to resize the map layers above and the data sources below"/>
                    <Expander Grid.Row="4" Header="Data sources" Margin="0,2,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="4,6,4,4">
                            <ItemsControl ItemsSource="{Binding MapDataSources}" Margin="0,0,0,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalContentAlignment="Center"/>
                                                <TextBlock Text="{Binding Url}" Foreground="#777777" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Status}" Foreground="#777777" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Remove" Padding="8,2" VerticalAlignment="Top"
                                                    Command="{Binding DataContext.RemoveMapDataSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Add a MapServer, FeatureServer layer, VectorTileServer or KML URL" Foreground="#777777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,4">
                                <TextBox x:Name="NewMapDataSourceNameBox" Text="{Binding NewMapDataSourceName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Display name (optional). Leave it empty to name the source from its service URL."/>
                                <TextBlock Text="Display name (optional)">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FieldPlaceholder}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=NewMapDataSourceNameBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <TextBox x:Name="NewMapDataSourceUrlBox" Text="{Binding NewMapDataSourceUrl, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Service URL, for example https://host/arcgis/rest/services/MA/Landbase_MA/MapServer"/>
                                <TextBlock Text="Service URL">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FieldPlaceholder}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=NewMapDataSourceUrlBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Content="Add data source" Command="{Binding AddMapDataSourceCommand}" Padding="8,2" HorizontalAlignment="Left"/>
                        </StackPanel>
                        </ScrollViewer>
                    </Expander>
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock x:Name="ExtentModeTitle" Text="Native ArcGIS Maps SDK MapView" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="Address:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="AddressSearchTextBox" Width="380" Margin="0,0,6,0" KeyDown="AddressSearchTextBox_KeyDown"/>
                            <Button Content="Go 1:960" Click="GoToAddress_Click" Padding="8,2" Margin="0,0,4,0"/>
                            <Button Content="Reset MA" Click="ResetMapView_Click" Padding="8,2"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" BorderBrush="#A0A0A0" BorderThickness="1" Background="#F5F5F5">
                        <ContentControl x:Name="ArcGisMapHost"/>
                    </Border>
                </Grid>
            </Grid>
                        <Grid x:Name="LayerPage" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <GroupBox Header="Layers" Grid.Column="0">
                    <ListBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="4">
                                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding GeometryType}" Foreground="Gray" FontSize="11"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>
                <GroupBox Header="Fields for selected layer" Grid.Column="2">
                    <DataGrid ItemsSource="{Binding SelectedLayer.Fields}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Export" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn Header="Field" Binding="{Binding Name}" IsReadOnly="True" Width="200"/>
                            <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" IsReadOnly="True" Width="260"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
            <Grid x:Name="TransformPage" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <GroupBox Header="Layer transformation rules" Grid.Column="0">
                    <ListBox ItemsSource="{Binding TransformRules}" SelectedItem="{Binding SelectedTransform}" DisplayMemberPath="LayerName"/>
                </GroupBox>
                <GroupBox Header="CAD import behavior" Grid.Column="2">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="CAD Layer Name" Margin="0,0,8,8"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedTransform.CadLayerName, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding CadLayers}" IsEditable="True" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Point Block" Margin="0,0,8,8"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTransform.BlockName, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Blocks}" IsEditable="True" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Line Type" Margin="0,0,8,8"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTransform.LineType, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding LineTypes}" IsEditable="True" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Color Mode" Margin="0,0,8,8"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedTransform.ColorMode, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,0,0,8">
                            <ComboBoxItem Content="ByLayer"/>
                            <ComboBoxItem Content="ACI"/>
                            <ComboBoxItem Content="RGB"/>
                        </ComboBox>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="ACI Color" Margin="0,0,8,8"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedTransform.AciColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Rotation +/- Degrees" Margin="0,0,8,8"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedTransform.RotationOffsetDegrees, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Scale" Margin="0,0,8,8"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding SelectedTransform.ScaleValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    </Grid>
                </GroupBox>
            </Grid>
            <Grid x:Name="ReviewPage" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Review + Export Plan" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding ResolvedExtentText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Content="Build Dry-Run Export Plan" Command="{Binding BuildReviewCommand}" Width="220" Padding="8" HorizontalAlignment="Left"/>
                    <TextBlock Text="The current version writes export-plan-latest.json. Actual CAD entity creation comes after this dry-run plan is validated." TextWrapping="Wrap" Margin="0,20,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button Content="Back" Command="{Binding BackCommand}" Width="100" Margin="0,0,8,0"/>
            <Button Content="Next" Command="{Binding NextCommand}" Width="100" Margin="0,0,8,0"/>
            <Button Content="Export / Build Plan" Command="{Binding ExportCommand}" Width="160"/>
        </DockPanel>
        <Border Grid.Row="3" Margin="0,10,0,0" Padding="8" Background="#F1F1F1" BorderBrush="#D0D0D0" BorderThickness="1">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
