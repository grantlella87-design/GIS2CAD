using System;
using System.Collections.Generic;
using System.Globalization;
using System.Linq;
using System.Text.Json;
using System.Threading.Tasks;
using System.Windows;
using Esri.ArcGISRuntime.Geometry;

namespace NG.GIS.CAD.Exporter.Views;

public partial class ExporterWindow
{
    private readonly List<Geometry> _manualProposedMainSegments = new List<Geometry>();
    private bool _isDrawingManualProposedMainSegment;

    private void StartManualProposedMainSegment_Click(object sender, RoutedEventArgs e)
    {
        try
        {
            if (_mapView == null || _geometryEditor == null)
            {
                WorkOrderGeometryTextBox.Text = "MapView or geometry editor is not initialized.";
                return;
            }
            if (_geometryEditor.IsStarted)
            {
                WorkOrderGeometryTextBox.Text = "A geometry edit is already active. Apply or cancel that edit first.";
                return;
            }
            _mapView.GeometryEditor = _geometryEditor;
            _geometryEditor.Start(GeometryType.Polyline);
            _isDrawingManualProposedMainSegment = true;
            if (DataContext is ViewModels.ExporterViewModel vm) { vm.Status = "Drawing manual proposed pipeline segment. Click Apply Segment when finished."; }
        }
        catch (Exception ex) { WorkOrderGeometryTextBox.Text = FlattenManualProposedMainException(ex); }
    }

    private void ApplyManualProposedMainSegment_Click(object sender, RoutedEventArgs e)
    {
        try
        {
            if (_geometryEditor == null || !_geometryEditor.IsStarted)
            {
                WorkOrderGeometryTextBox.Text = "No manual proposed pipeline segment is currently being drawn.";
                return;
            }
            var geometry = _geometryEditor.Stop();
            _isDrawingManualProposedMainSegment = false;
            if (geometry == null || geometry.IsEmpty)
            {
                WorkOrderGeometryTextBox.Text = "Manual proposed pipeline segment was empty.";
                return;
            }
            var projected = geometry.SpatialReference?.Wkid == 3857 ? geometry : GeometryEngine.Project(geometry, SpatialReferences.WebMercator);
            if (projected == null || projected.IsEmpty)
            {
                WorkOrderGeometryTextBox.Text = "Manual proposed pipeline segment could not be projected to Web Mercator.";
                return;
            }
            _manualProposedMainSegments.Add(projected);
            RedrawManualProposedMainSegments(false);
            if (DataContext is ViewModels.ExporterViewModel vm) { vm.Status = "Added manual proposed pipeline segment " + _manualProposedMainSegments.Count + ". Start another segment or finish manual mains."; }
        }
        catch (Exception ex) { WorkOrderGeometryTextBox.Text = FlattenManualProposedMainException(ex); }
    }

    private async void FinishManualProposedMainSegments_Click(object sender, RoutedEventArgs e)
    {
        try
        {
            if (_geometryEditor != null && _geometryEditor.IsStarted)
            {
                var geometry = _geometryEditor.Stop();
                _isDrawingManualProposedMainSegment = false;
                if (geometry != null && !geometry.IsEmpty)
                {
                    var projected = geometry.SpatialReference?.Wkid == 3857 ? geometry : GeometryEngine.Project(geometry, SpatialReferences.WebMercator);
                    if (projected != null && !projected.IsEmpty) { _manualProposedMainSegments.Add(projected); }
                }
            }
            if (_manualProposedMainSegments.Count == 0)
            {
                WorkOrderGeometryTextBox.Text = "No manual proposed pipeline segments have been added.";
                return;
            }
            var snapped = SnapGeometriesWithinOneFoot(_manualProposedMainSegments, out var snapCount).ToList();
            _manualProposedMainSegments.Clear();
            _manualProposedMainSegments.AddRange(snapped);
            RedrawManualProposedMainSegments(true);
            var unionGeometry = _manualProposedMainSegments.Count == 1 ? _manualProposedMainSegments[0] : GeometryEngine.Union(_manualProposedMainSegments);
            _editableImportedProposedMainGeometry = unionGeometry;
            _editableImportedProposedMainSymbol ??= new Services.ProposedMainRestSymbol();
            _editableImportedProposedMainWorkOrderId = GetSelectedNgOdsWorkOrderNumberForProposedMain();
            var paddingFeet = GetSharedPaddingFeetForWorkOrderImport();
            var buffered = paddingFeet > 0 && unionGeometry != null && !unionGeometry.IsEmpty ? GeometryEngine.Buffer(unionGeometry, paddingFeet * 0.3048) : unionGeometry;
            var extent = buffered?.Extent ?? BuildEnvelopeFromGeometries(_manualProposedMainSegments);
            if (extent != null)
            {
                if (_mapView != null) { await _mapView.SetViewpointGeometryAsync(ExpandEnvelopeByFeet(extent, 200), 20); }
                CommitExtentToViewModelForWorkOrderImport(extent);
                WriteManualProposedMainProof(extent, paddingFeet, snapCount);
            }
            if (DataContext is ViewModels.ExporterViewModel vm) { vm.Status = "Finished " + _manualProposedMainSegments.Count + " manual proposed pipeline segment(s). Endpoint snaps applied: " + snapCount + "."; }
        }
        catch (Exception ex) { WorkOrderGeometryTextBox.Text = FlattenManualProposedMainException(ex); }
    }

    private void ClearManualProposedMainSegments_Click(object sender, RoutedEventArgs e)
    {
        try
        {
            if (_geometryEditor != null && _geometryEditor.IsStarted) { _geometryEditor.Stop(); }
            _manualProposedMainSegments.Clear();
            _isDrawingManualProposedMainSegment = false;
            _workOrderOverlay?.Graphics.Clear();
            WorkOrderGeometryTextBox.Text = "Manual proposed pipeline segments cleared.";
            if (DataContext is ViewModels.ExporterViewModel vm) { vm.Status = "Manual proposed pipeline segments cleared."; }
        }
        catch (Exception ex) { WorkOrderGeometryTextBox.Text = FlattenManualProposedMainException(ex); }
    }

    private void RedrawManualProposedMainSegments(bool includeBuffer)
    {
        var symbol = _editableImportedProposedMainSymbol ?? new Services.ProposedMainRestSymbol();
        DrawProposedMainGeometries(_manualProposedMainSegments, symbol);
    }

    private void WriteManualProposedMainProof(Envelope extent, double paddingFeet, int snapCount)
    {
        var proof = new
        {
            source = "manual proposed pipeline",
            selectedWorkOrder = GetSelectedNgOdsWorkOrderNumberForProposedMain(),
            segmentCount = _manualProposedMainSegments.Count,
            endpointSnapsApplied = snapCount,
            paddingFeet,
            wkid = 3857,
            xmin = Math.Round(extent.XMin, 3),
            ymin = Math.Round(extent.YMin, 3),
            xmax = Math.Round(extent.XMax, 3),
            ymax = Math.Round(extent.YMax, 3),
            capturedLocalTime = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)
        };
        WorkOrderGeometryTextBox.Text = JsonSerializer.Serialize(proof, new JsonSerializerOptions { WriteIndented = true });
    }

    private static string FlattenManualProposedMainException(Exception ex)
    {
        var messages = new List<string>();
        for (var current = ex; current != null; current = current.InnerException) { messages.Add(current.GetType().Name + ": " + current.Message); }
        return string.Join(" -> ", messages);
    }
}
