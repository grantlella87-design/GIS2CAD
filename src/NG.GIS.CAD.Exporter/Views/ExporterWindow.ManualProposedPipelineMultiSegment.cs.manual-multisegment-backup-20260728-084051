using System;
using System.Collections.Generic;
using System.Globalization;
using System.Linq;
using System.Reflection;
using System.Text.Json;
using System.Threading.Tasks;
using System.Windows;
using Esri.ArcGISRuntime.Geometry;

namespace NG.GIS.CAD.Exporter.Views;

public partial class ExporterWindow
{
    private readonly List<Geometry> _manualProposedPipelineSegments = new List<Geometry>();

    private void StartProposedPipeline_Click(object sender, RoutedEventArgs e)
    {
        try
        {
            if (_mapView == null || _geometryEditor == null)
            {
                WorkOrderGeometryTextBox.Text = "MapView or geometry editor is not initialized.";
                return;
            }
            if (_geometryEditor.IsStarted)
            {
                WorkOrderGeometryTextBox.Text = "A segment is already being drawn. Use Apply Segment or Finish Manual first.";
                return;
            }
            _mapView.GeometryEditor = _geometryEditor;
            _geometryEditor.Start(GeometryType.Polyline);
            WorkOrderGeometryTextBox.Text = "Drawing manual proposed pipeline segment. Click vertices on the map, then use Apply Segment. Repeat for multiple segments, then use Finish Manual.";
            SetManualPipelineStatus("Manual proposed pipeline segment started.");
        }
        catch (Exception ex)
        {
            WorkOrderGeometryTextBox.Text = FlattenManualPipelineException(ex);
        }
    }

    private void FinishProposedPipeline_Click(object sender, RoutedEventArgs e)
    {
        try
        {
            AddCurrentManualSegmentFromEditor();
            RedrawManualProposedPipelineSegments();
            WorkOrderGeometryTextBox.Text = "Manual proposed pipeline segment count: " + _manualProposedPipelineSegments.Count + ". Start another segment or use Finish Manual.";
            SetManualPipelineStatus("Applied manual proposed pipeline segment " + _manualProposedPipelineSegments.Count + ".");
        }
        catch (Exception ex)
        {
            WorkOrderGeometryTextBox.Text = FlattenManualPipelineException(ex);
        }
    }

    private async void CancelProposedPipeline_Click(object sender, RoutedEventArgs e)
    {
        try
        {
            if (_geometryEditor != null && _geometryEditor.IsStarted) { AddCurrentManualSegmentFromEditor(); }
            if (_manualProposedPipelineSegments.Count == 0)
            {
                WorkOrderGeometryTextBox.Text = "No manual proposed pipeline segments have been added.";
                return;
            }
            var snapped = TrySnapManualSegments(_manualProposedPipelineSegments, out var snapCount).ToList();
            _manualProposedPipelineSegments.Clear();
            _manualProposedPipelineSegments.AddRange(snapped);
            RedrawManualProposedPipelineSegments();
            var unionGeometry = _manualProposedPipelineSegments.Count == 1 ? _manualProposedPipelineSegments[0] : GeometryEngine.Union(_manualProposedPipelineSegments);
            _editableImportedProposedMainGeometry = unionGeometry;
            _editableImportedProposedMainSymbol ??= new NG.GIS.CAD.Exporter.Services.ProposedMainRestSymbol();
            _editableImportedProposedMainWorkOrderId = GetSelectedWorkOrderNumberForManualPipeline();
            var paddingFeet = GetManualPipelinePaddingFeet();
            var buffered = paddingFeet > 0 && unionGeometry != null && !unionGeometry.IsEmpty ? GeometryEngine.Buffer(unionGeometry, paddingFeet * 0.3048) : unionGeometry;
            var extent = buffered?.Extent ?? BuildManualPipelineEnvelope(_manualProposedPipelineSegments);
            if (extent != null)
            {
                if (_mapView != null) { await _mapView.SetViewpointGeometryAsync(ExpandEnvelopeByFeet(extent, 200), 20); }
                CommitExtentForManualPipeline(extent);
                WriteManualPipelineProof(extent, paddingFeet, snapCount);
            }
            SetManualPipelineStatus("Finished " + _manualProposedPipelineSegments.Count + " manual proposed pipeline segment(s). Endpoint snaps applied: " + snapCount + ".");
        }
        catch (Exception ex)
        {
            WorkOrderGeometryTextBox.Text = FlattenManualPipelineException(ex);
        }
    }

    private void ClearProposedPipeline_Click(object sender, RoutedEventArgs e)
    {
        try
        {
            if (_geometryEditor != null && _geometryEditor.IsStarted) { _geometryEditor.Stop(); }
            _manualProposedPipelineSegments.Clear();
            _workOrderOverlay?.Graphics.Clear();
            WorkOrderGeometryTextBox.Text = "Manual proposed pipeline segments cleared.";
            SetManualPipelineStatus("Manual proposed pipeline segments cleared.");
        }
        catch (Exception ex)
        {
            WorkOrderGeometryTextBox.Text = FlattenManualPipelineException(ex);
        }
    }

    private void AddCurrentManualSegmentFromEditor()
    {
        if (_geometryEditor == null || !_geometryEditor.IsStarted)
        {
            WorkOrderGeometryTextBox.Text = "No segment is currently being drawn. Use Start Segment first.";
            return;
        }
        var geometry = _geometryEditor.Stop();
        if (geometry == null || geometry.IsEmpty)
        {
            WorkOrderGeometryTextBox.Text = "Manual proposed pipeline segment was empty.";
            return;
        }
        var projected = geometry.SpatialReference?.Wkid == 3857 ? geometry : GeometryEngine.Project(geometry, SpatialReferences.WebMercator);
        if (projected == null || projected.IsEmpty)
        {
            WorkOrderGeometryTextBox.Text = "Manual proposed pipeline segment could not be projected to Web Mercator.";
            return;
        }
        _manualProposedPipelineSegments.Add(projected);
    }

    private void RedrawManualProposedPipelineSegments()
    {
        if (_manualProposedPipelineSegments.Count == 0)
        {
            _workOrderOverlay?.Graphics.Clear();
            return;
        }
        var symbol = _editableImportedProposedMainSymbol ?? new NG.GIS.CAD.Exporter.Services.ProposedMainRestSymbol();
        DrawProposedMainGeometries(_manualProposedPipelineSegments, symbol);
    }

    private static IReadOnlyList<Geometry> TrySnapManualSegments(IReadOnlyList<Geometry> segments, out int snapCount)
    {
        snapCount = 0;
        var type = typeof(ExporterWindow);
        var method = type.GetMethod("SnapGeometriesWithinOneFoot", BindingFlags.NonPublic | BindingFlags.Static);
        if (method == null) { return segments; }
        object[] args = new object[] { segments, 0 };
        var result = method.Invoke(null, args) as IReadOnlyList<Geometry>;
        snapCount = args[1] is int count ? count : 0;
        return result ?? segments;
    }

    private double GetManualPipelinePaddingFeet()
    {
        if (WorkOrderPaddingTextBox != null && double.TryParse(WorkOrderPaddingTextBox.Text, NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed)) { return Math.Max(0, parsed); }
        if (WorkOrderPaddingTextBox != null && double.TryParse(WorkOrderPaddingTextBox.Text, out parsed)) { return Math.Max(0, parsed); }
        return 0;
    }

    private string GetSelectedWorkOrderNumberForManualPipeline()
    {
        var selected = WorkOrderSelectionComboBox?.SelectedItem;
        if (selected != null)
        {
            var prop = selected.GetType().GetProperty("WorkOrderNumber", BindingFlags.Public | BindingFlags.Instance);
            var value = prop?.GetValue(selected)?.ToString();
            if (!string.IsNullOrWhiteSpace(value)) { return value.Trim(); }
        }
        return WorkOrderSelectionComboBox?.Text?.Trim() ?? string.Empty;
    }

    private static Envelope? BuildManualPipelineEnvelope(IReadOnlyList<Geometry> geometries)
    {
        Envelope? extent = null;
        foreach (var geometry in geometries)
        {
            if (geometry == null || geometry.IsEmpty) { continue; }
            if (extent == null) { extent = geometry.Extent; }
            else
            {
                extent = new Envelope(
                    Math.Min(extent.XMin, geometry.Extent.XMin),
                    Math.Min(extent.YMin, geometry.Extent.YMin),
                    Math.Max(extent.XMax, geometry.Extent.XMax),
                    Math.Max(extent.YMax, geometry.Extent.YMax),
                    SpatialReferences.WebMercator);
            }
        }
        return extent;
    }

    private void CommitExtentForManualPipeline(Envelope extent)
    {
        var vm = DataContext;
        if (vm == null || extent == null) { return; }
        var method = vm.GetType().GetMethod("SetExtentFromMap", BindingFlags.Public | BindingFlags.Instance);
        method?.Invoke(vm, new object[] { extent.XMin, extent.YMin, extent.XMax, extent.YMax, 3857 });
    }

    private void WriteManualPipelineProof(Envelope extent, double paddingFeet, int snapCount)
    {
        var proof = new
        {
            source = "manual proposed pipeline",
            selectedWorkOrder = GetSelectedWorkOrderNumberForManualPipeline(),
            segmentCount = _manualProposedPipelineSegments.Count,
            endpointSnapsApplied = snapCount,
            paddingFeet,
            wkid = 3857,
            xmin = Math.Round(extent.XMin, 3),
            ymin = Math.Round(extent.YMin, 3),
            xmax = Math.Round(extent.XMax, 3),
            ymax = Math.Round(extent.YMax, 3),
            capturedLocalTime = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)
        };
        WorkOrderGeometryTextBox.Text = JsonSerializer.Serialize(proof, new JsonSerializerOptions { WriteIndented = true });
    }

    private void SetManualPipelineStatus(string message)
    {
        if (DataContext is ViewModels.ExporterViewModel vm) { vm.Status = message; }
    }

    private static string FlattenManualPipelineException(Exception ex)
    {
        var messages = new List<string>();
        for (var current = ex; current != null; current = current.InnerException) { messages.Add(current.GetType().Name + ": " + current.Message); }
        return string.Join(" -> ", messages);
    }
}
