using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.IO;
using System.Linq;
using System.Net.Http;
using System.Net.Http.Headers;
using System.Text.Json;
using System.Threading.Tasks;
using Microsoft.Identity.Client;

namespace NG.GIS.CAD.Exporter.Services;

internal sealed class SharePointDwtTemplateService
{
    private const string ClientId = "14d82eec-204b-4c2f-b7e8-296a70dab67e";
    private const string TenantId = "f98a6a53-25f3-4212-901c-c7787fcd3495";
    private const string GraphRoot = "https://graph.microsoft.com/v1.0";
    private const string DefaultDriveId = "b!oQf4lQnCX0qt-hTuSFmXrP4QVHfYL_1Mo26SJGoClkz_SltDsJ3rT4gTLzMV1xCP";
    private const string DefaultFolderPath = "Boston Cape Gas Dist Eng Design/CAD Template/Template - BOSTON TEAM";
    private static readonly string[] Scopes = new[] { "User.Read", "Files.Read.All" };
    private readonly IPublicClientApplication _app;
    private readonly HttpClient _http = new HttpClient();

    internal SharePointDwtTemplateService()
    {
        _app = PublicClientApplicationBuilder.Create(ClientId).WithTenantId(TenantId).WithRedirectUri("http://localhost").Build();
    }

    internal async Task<IReadOnlyList<SharePointDwtTemplateItem>> ListDefaultTemplatesAsync()
    {
        var token = await GetAccessTokenAsync();
        _http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        var list = new List<SharePointDwtTemplateItem>();
        await AddTemplatesFromFolderAsync(DefaultDriveId, DefaultFolderPath, list);
        return list.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase).ToList();
    }

    internal async Task<string> DownloadTemplateAsync(SharePointDwtTemplateItem item)
    {
        var token = await GetAccessTokenAsync();
        using var req = new HttpRequestMessage(HttpMethod.Get, GraphRoot + "/drives/" + Uri.EscapeDataString(item.DriveId) + "/items/" + Uri.EscapeDataString(item.ItemId) + "/content");
        req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
        using var resp = await _http.SendAsync(req);
        resp.EnsureSuccessStatusCode();
        var dir = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "NationalGrid", "GisCadExporter", "Templates");
        Directory.CreateDirectory(dir);
        var safeName = string.Concat(item.Name.Select(c => Path.GetInvalidFileNameChars().Contains(c) ? '_' : c));
        if (!safeName.EndsWith(".dwt", StringComparison.OrdinalIgnoreCase)) safeName += ".dwt";
        var path = Path.Combine(dir, safeName);
        await using var fs = File.Create(path);
        await resp.Content.CopyToAsync(fs);
        return path;
    }

    internal static void OpenTemplatePath(string path)
    {
        if (!File.Exists(path)) throw new FileNotFoundException("Downloaded template was not found.", path);
        Process.Start(new ProcessStartInfo(path) { UseShellExecute = true });
    }

    private async Task AddTemplatesFromFolderAsync(string driveId, string folderPath, List<SharePointDwtTemplateItem> list)
    {
        var endpoint = "/drives/" + Uri.EscapeDataString(driveId) + "/root:/" + EscapePath(folderPath) + ":/children";
        var json = await GetJsonAsync(endpoint);
        foreach (var child in json.RootElement.GetProperty("value").EnumerateArray())
        {
            var name = child.GetProperty("name").GetString() ?? string.Empty;
            if (child.TryGetProperty("folder", out _))
            {
                await AddTemplatesFromFolderAsync(driveId, folderPath.TrimEnd('/') + "/" + name, list);
                continue;
            }
            if (!name.EndsWith(".dwt", StringComparison.OrdinalIgnoreCase)) continue;
            list.Add(new SharePointDwtTemplateItem(driveId, child.GetProperty("id").GetString() ?? string.Empty, name, child.TryGetProperty("webUrl", out var webUrl) ? webUrl.GetString() ?? string.Empty : string.Empty));
        }
    }

    private static string EscapePath(string path) => string.Join("/", path.Split(new[] { '/' }, StringSplitOptions.RemoveEmptyEntries).Select(Uri.EscapeDataString));

    private async Task<JsonDocument> GetJsonAsync(string graphPath)
    {
        using var req = new HttpRequestMessage(HttpMethod.Get, GraphRoot + graphPath);
        using var resp = await _http.SendAsync(req);
        var text = await resp.Content.ReadAsStringAsync();
        if (!resp.IsSuccessStatusCode) throw new InvalidOperationException("Graph request failed: " + resp.StatusCode + Environment.NewLine + text);
        return JsonDocument.Parse(text);
    }

    private async Task<string> GetAccessTokenAsync()
    {
        var accounts = await _app.GetAccountsAsync();
        try { return (await _app.AcquireTokenSilent(Scopes, accounts.FirstOrDefault()).ExecuteAsync()).AccessToken; }
        catch { return (await _app.AcquireTokenInteractive(Scopes).WithUseEmbeddedWebView(false).ExecuteAsync()).AccessToken; }
    }
}

internal sealed record SharePointDwtTemplateItem(string DriveId, string ItemId, string Name, string WebUrl)
{
    public override string ToString() => Name;
}