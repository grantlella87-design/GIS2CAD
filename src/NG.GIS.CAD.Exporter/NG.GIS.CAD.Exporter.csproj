<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <!-- AutoCAD's colour dialog is a WinForms dialog and returns a WinForms DialogResult. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms adds global usings for System.Windows.Forms and System.Drawing. In a WPF
         codebase those collide with the WPF types of the same name: KeyEventArgs, TextBox, Color,
         Point and more. The assemblies are wanted, the global imports are not, so they are dropped
         and the one WinForms type used is named in full at its single call site. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- A build machine has no AutoCAD installed, so there is nothing at AcadReferencePath to reference.
       The same three assemblies are published by Autodesk on NuGet, and CI takes them from there.

       A developer machine is left exactly as it was: this switches on the CI environment variable that
       GitHub Actions sets, so a local build still reads the installed AutoCAD and owes nothing to NuGet.
       Set UseAutoCadNuGet explicitly to force either way.

       Pinned to 25.0.0 because that is the last version published as net8.0; 26.0.0 ships net10.0
       assemblies, which a net8.0 project cannot consume. The target framework is not free to move up
       either, since Esri.ArcGISRuntime.WPF 300.0.0 is itself net8.0-windows10.0.19041. -->
  <PropertyGroup>
    <UseAutoCadNuGet Condition="'$(UseAutoCadNuGet)' == '' and '$(CI)' == 'true'">true</UseAutoCadNuGet>
    <UseAutoCadNuGet Condition="'$(UseAutoCadNuGet)' == ''">false</UseAutoCadNuGet>
    <AutoCadNuGetVersion Condition="'$(AutoCadNuGetVersion)' == ''">25.0.0</AutoCadNuGetVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseAutoCadNuGet)' != 'true'">
    <Reference Include="AcMgd">
      <HintPath>$(AcadReferencePath)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AcadReferencePath)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AcadReferencePath)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ExcludeAssets="runtime" is the Private=false above in package form: AutoCAD supplies these at run
       time, and a plug-in that shipped its own copies beside the DLL would be loading a second set into
       a process that already has them. -->
  <ItemGroup Condition="'$(UseAutoCadNuGet)' == 'true'">
    <PackageReference Include="AutoCAD.NET" Version="$(AutoCadNuGetVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Core" Version="$(AutoCadNuGetVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Model" Version="$(AutoCadNuGetVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Esri.ArcGISRuntime.WPF" Version="300.0.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.87.0" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.87.0" />
  </ItemGroup>

</Project>
